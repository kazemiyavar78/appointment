{
  "name": "tebpardaz-server-assets",
  "private": true,
  "version": "0.0.1",
  "description": "CSS build tooling for tebpardaz server (Tailwind 3.4 + PostCSS for legacy browsers)",
  "scripts": {
    "build:css": "tailwindcss -i ./static/css/input.css -o ./static/css/output.css --minify",
    "watch:css": "tailwindcss -i ./static/css/input.css -o ./static/css/output.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "postcss-preset-env": "^10.1.3",
    "tailwindcss": "^3.4.0"
  }
}
