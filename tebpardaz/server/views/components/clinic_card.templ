package components

import "strconv"

// ClinicCardView is a subsidiary clinic summary for organ/platform home pages.
type ClinicCardView struct {
	ID       uint
	Name     string
	Address  string
	Phone    string
	Province string
	City     string
}

// clinicFilterURL builds /doctors?clinic_id={id} for quick booking filter.
// Input: clinic ID. Output: relative filter URL.
func clinicFilterURL(id uint) string {
	return "/doctors?clinic_id=" + strconv.FormatUint(uint64(id), 10)
}

// ClinicCard renders clinic contact/location details linking to the doctor list filter.
templ ClinicCard(view ClinicCardView) {
	<a
		class="group flex h-full min-w-0 flex-col overflow-hidden rounded-xl border border-surface-border bg-white shadow-sm transition hover:border-brand/50 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2"
		href={ templ.SafeURL(clinicFilterURL(view.ID)) }
	>
		<div class="flex min-w-0 flex-1 flex-col gap-2.5 p-4">
			<h3 class="break-words text-base font-bold leading-snug text-ink [overflow-wrap:anywhere]">
				{ view.Name }
			</h3>
			if view.City != "" || view.Province != "" {
				<p class="break-words text-sm text-ink-muted [overflow-wrap:anywhere]">
					if view.Province != "" && view.City != "" {
						{ view.Province } — { view.City }
					} else if view.Province != "" {
						{ view.Province }
					} else {
						{ view.City }
					}
				</p>
			}
			if view.Address != "" {
				<p class="break-words text-sm leading-relaxed text-ink-muted [overflow-wrap:anywhere]">
					{ view.Address }
				</p>
			}
			if view.Phone != "" {
				<p class="mt-auto break-words text-sm font-medium tabular-nums text-ink [overflow-wrap:anywhere]" dir="ltr">
					{ view.Phone }
				</p>
			}
		</div>
		<div class="mt-auto flex items-center justify-between gap-2 border-t border-surface-border bg-surface-soft/60 px-4 py-3">
			<span class="text-sm font-medium text-brand transition group-hover:text-brand-dark">
				مشاهده پزشکان
			</span>
			<span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand/10 text-brand transition group-hover:bg-brand group-hover:text-white" aria-hidden="true">
				<svg class="h-3.5 w-3.5 rotate-180" viewBox="0 0 20 20" fill="currentColor">
					<path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"></path>
				</svg>
			</span>
		</div>
	</a>
}
