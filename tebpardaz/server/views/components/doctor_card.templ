package components

import "strconv"
import "strings"
import "time"
import ptime "github.com/yaa110/go-persian-calendar"

// doctorCardPhotoSizes عرض چیدمان عکس کارت را برای انتخاب منبع srcset توصیف می‌کند.
// موبایل تقریباً تمام‌عرض، تبلت دو ستونه و دسکتاپ حدود ۲۲rem است؛
// کمی بزرگ‌تر از عرض واقعی تا روی دستگاه‌های با DPR بالا عکس تیز بماند.
const doctorCardPhotoSizes = "(max-width: 639px) calc(100vw - 2.5rem), (max-width: 1279px) calc(50vw - 2rem), 22rem"

// DoctorCardView مدل نمایش کارت رزرو پزشک عمومی است.
type DoctorCardView struct {
	Name            string
	SpecialtyName   string
	DoctorSystemID  int
	PhotoURL        string
	Photo300        string
	Photo600        string
	Photo900        string
	Photo1200       string
	ShortDesc       string
	ClinicName      string
	ShowClinicBadge bool
	HasSlot         bool
	NearestStartsAt time.Time
	BookingURL      string
}

// DoctorCardAssets استایل کارت پزشک را بارگذاری می‌کند.
templ DoctorCardAssets() {
	<link rel="stylesheet" href="/static/css/CardCss.css"/>
}

// formatShamsiDateTime زمان را به رشته تاریخ-ساعت جلالی تبدیل می‌کند.
// ورودی: زمان دیواری. خروجی: yyyy/MM/dd HH:mm یا «—» اگر صفر باشد.
func formatShamsiDateTime(t time.Time) string {
	if t.IsZero() {
		return "—"
	}
	return ptime.New(t).Format("yyyy/MM/dd HH:mm")
}

// doctorCardSlotDate فقط تاریخ-ساعت جلالی نوبت آزاد را برمی‌گرداند.
// ورودی: نزدیک‌ترین نوبت. خروجی: رشته قالب‌بندی‌شده یا خالی.
func doctorCardSlotDate(t time.Time) string {
	if t.IsZero() {
		return ""
	}
	return formatShamsiDateTime(t)
}

// doctorCardCTALabel برچسب دکمه اقدام را از وضعیت نوبت برمی‌گزیند.
// ورودی: hasSlot. خروجی: متن فارسی CTA.
func doctorCardCTALabel(hasSlot bool) string {
	if hasSlot {
		return "رزرو نوبت"
	}
	return "مشاهده جزئیات"
}

// doctorCardSpecialtyLabel متن نشان تخصص روی تصویر را برمی‌گرداند.
// ورودی: view. خروجی: نام تخصص یا رشته خالی.
func doctorCardSpecialtyLabel(view DoctorCardView) string {
	return strings.TrimSpace(view.SpecialtyName)
}

// doctorCardClinicLabel نام درمانگاه را برای نشان لایه ارگان و پلتفرم برمی‌گرداند.
// ورودی: view. خروجی: نام مرکز وقتی ShowClinicBadge فعال است، وگرنه خالی.
func doctorCardClinicLabel(view DoctorCardView) string {
	if !view.ShowClinicBadge {
		return ""
	}
	return strings.TrimSpace(view.ClinicName)
}

// doctorCardMetaPrimary متن اصلی ردیف متا را از نوبت یا توضیح کوتاه می‌سازد.
// ورودی: view. خروجی: متن فارسی برای نمایش.
func doctorCardMetaPrimary(view DoctorCardView) string {
	if view.HasSlot {
		if slot := doctorCardSlotDate(view.NearestStartsAt); slot != "" {
			return "نزدیک‌ترین نوبت: " + slot
		}
	}
	if view.ShortDesc != "" {
		return view.ShortDesc
	}
	if !view.HasSlot {
		return "بدون نوبت باز"
	}
	return ""
}

// doctorCardMetaSecondary توضیح کوتاه را برای نمایش زیر نزدیک‌ترین نوبت برمی‌گرداند.
// ورودی: view. خروجی: توضیح کوتاه وقتی نوبت نمایش داده می‌شود، وگرنه خالی.
func doctorCardMetaSecondary(view DoctorCardView) string {
	desc := strings.TrimSpace(view.ShortDesc)
	if desc == "" || !view.HasSlot || doctorCardSlotDate(view.NearestStartsAt) == "" {
		return ""
	}
	return desc
}

// doctorCardImgAlt متن جایگزین تصویر پزشک را به صورت توصیفی و بهینه برای سئو می‌سازد.
// ورودی: view حاوی نام پزشک، تخصص و نام مرکز. خروجی: متن فارسی توصیفی برای تگ alt.
func doctorCardImgAlt(view DoctorCardView) string {
	res := "تصویر و نوبت‌دهی " + view.Name
	if view.SpecialtyName != "" {
		res += " - " + view.SpecialtyName
	}
	if view.ClinicName != "" {
		res += " در " + view.ClinicName
	}
	return res
}

// doctorCardAriaLabel برچسب دسترسی‌پذیری پیوند کارت پزشک را تولید می‌کند.
// ورودی: view حاوی مشخصات پزشک. خروجی: متن فارسی توصیفی برای aria-label.
func doctorCardAriaLabel(view DoctorCardView) string {
	label := "رزرو اینترنتی نوبت " + view.Name
	if view.SpecialtyName != "" {
		label += " (" + view.SpecialtyName + ")"
	}
	return label
}

// doctorCardMainPhoto آدرس تصویر اصلی یا سایز ۱۲۰۰ پزشک را برمی‌گرداند.
// ورودی: view حاوی آدرس تصاویر در ابعاد مختلف. خروجی: آدرس تصویر با بالاترین کیفیت یا پیش‌فرض.
func doctorCardMainPhoto(view DoctorCardView) string {
	if view.Photo1200 != "" {
		return view.Photo1200
	}
	if view.Photo900 != "" {
		return view.Photo900
	}
	if view.Photo600 != "" {
		return view.Photo600
	}
	if view.Photo300 != "" {
		return view.Photo300
	}
	return view.PhotoURL
}

// doctorCardHasPhoto وجود داشتن حداقل یکی از تصاویر پزشک را بررسی می‌کند.
// ورودی: view حاوی آدرس تصاویر. خروجی: true در صورت وجود تصویر.
func doctorCardHasPhoto(view DoctorCardView) bool {
	return view.PhotoURL != "" || view.Photo1200 != "" || view.Photo900 != "" || view.Photo600 != "" || view.Photo300 != ""
}

// doctorCardSrcSet رشته srcset با توصیف‌گر w را از عکس‌های مربع پزشک می‌سازد.
// ورودی: view حاوی آدرس تصاویر ۳۰۰ تا ۱۲۰۰. خروجی: «url 300w, url 600w, ...» یا رشته خالی.
func doctorCardSrcSet(view DoctorCardView) string {
	candidates := []struct {
		url   string
		width int
	}{
		{view.Photo300, 300},
		{view.Photo600, 600},
		{view.Photo900, 900},
		{view.Photo1200, 1200},
	}
	parts := make([]string, 0, len(candidates))
	for _, item := range candidates {
		if item.url == "" {
			continue
		}
		parts = append(parts, item.url+" "+strconv.Itoa(item.width)+"w")
	}
	return strings.Join(parts, ", ")
}

// DoctorCard خلاصه پزشک قابل کلیک به صفحه رزرو را رندر می‌کند.
templ DoctorCard(view DoctorCardView) {
	<a
		class="doctor-card group"
		href={ templ.SafeURL(view.BookingURL) }
		aria-label={ doctorCardAriaLabel(view) }
	>
		<div class="doctor-card-photo">
			if doctorCardHasPhoto(view) {
				<picture>
					<img
						src={ doctorCardMainPhoto(view) }
						if srcset := doctorCardSrcSet(view); srcset != "" {
							srcset={ srcset }
							sizes={ doctorCardPhotoSizes }
						}
						alt={ doctorCardImgAlt(view) }
						class="doctor-image doctor-card-photo-img"
						loading="lazy"
						decoding="async"
						width="120"
						height="120"
					/>
				</picture>
			} else {
				<svg class="doctor-card-photo-placeholder" viewBox="0 0 190 210" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<ellipse cx="95" cy="205" rx="95" ry="30" fill="#5b8bd9"></ellipse>
					<path d="M40 210 C40 150 55 120 95 120 C135 120 150 150 150 210 Z" fill="#5b8bd9"></path>
					<circle cx="95" cy="80" r="52" fill="#e7b18a"></circle>
					<path d="M45 75 C45 35 145 35 145 75 C145 55 130 40 95 40 C60 40 45 55 45 75 Z" fill="#7a4a2b"></path>
					<circle cx="95" cy="120" r="14" fill="#f1f1f1" stroke="#9ab" stroke-width="2"></circle>
				</svg>
			}
			if specialty := doctorCardSpecialtyLabel(view); specialty != "" || doctorCardClinicLabel(view) != "" {
				<div class="doctor-card-badges">
					if specialty != "" {
						<span class="doctor-card-badge">
							<span class="doctor-card-badge-icon" aria-hidden="true">🩺</span>
							{ specialty }
						</span>
					}
					if clinic := doctorCardClinicLabel(view); clinic != "" {
						<span class="doctor-card-badge doctor-card-badge-clinic">
							<span class="doctor-card-badge-icon" aria-hidden="true">🏥</span>
							{ clinic }
						</span>
					}
				</div>
			}
		</div>

		<div class="doctor-card-info">
			<h2 class="doctor-card-name">{ view.Name }</h2>
			if primary := doctorCardMetaPrimary(view); primary != "" || doctorCardMetaSecondary(view) != "" {
				<div class="doctor-card-meta">
					if primary != "" {
						<span class="doctor-card-meta-primary">{ primary }</span>
					}
					if desc := doctorCardMetaSecondary(view); desc != "" {
						<span class="doctor-card-short-desc">{ desc }</span>
					}
				</div>
			}
			<div class="doctor-card-actions">
				<span class="doctor-card-book-btn">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<rect x="3" y="5" width="18" height="16" rx="2"></rect>
						<path d="M8 3v4M16 3v4M3 10h18"></path>
					</svg>
					{ doctorCardCTALabel(view.HasSlot) }
				</span>
				<span class="doctor-card-icon-btn" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none" stroke="#5b6bd9" stroke-width="2">
						<path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.4 8.5 8.5 0 0 1-4-1L3 20l1.1-5.5A8.5 8.5 0 1 1 21 11.5z"></path>
					</svg>
				</span>
			</div>
		</div>
	</a>
}
