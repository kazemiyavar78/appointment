package components

// NavDropdownItem یک گزینه زیرمجموعه در منوی کشویی نوار ناوبری است.
type NavDropdownItem struct {
	Label  string
	Href   string
	Active bool
}

// NavLink یک آیتم در نوار ناوبری عمومی است (می‌تواند دارای زیرمنوهای Children باشد).
type NavLink struct {
	Label    string
	Href     string
	Active   bool
	Children []NavDropdownItem
}

// NavbarProps دادهٔ هدر عمومی (پلتفرم، ارگان یا کلینیک) را نگه می‌دارد.
type NavbarProps struct {
	BrandName string
	LogoURL   string
	HomeURL   string
	NavLinks  []NavLink
}

// Navbar هدر RTL موبایل‌اول با منوی disclosure بدون JS را رندر می‌کند.
templ Navbar(props NavbarProps) {
	<header class="sticky top-0 z-40 border-b border-surface-border bg-white">
		<div class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-3 px-4 sm:h-16 sm:px-6 lg:px-8">
			<a class="flex min-h-[44px] min-w-0 items-center gap-2.5 text-brand" href={ homeHref(props.HomeURL) }>
				if props.LogoURL != "" {
					<img
						class="h-9 w-9 shrink-0 rounded-full object-cover ring-2 ring-brand/15 sm:h-10 sm:w-10"
						src={ props.LogoURL }
						alt={ props.BrandName }
						width="40"
						height="40"
					/>
				} else {
					<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand text-sm font-bold text-white sm:h-10 sm:w-10">
						{ brandInitial(props.BrandName) }
					</span>
				}
				<span class="truncate text-lg font-bold tracking-tight sm:text-xl">{ props.BrandName }</span>
			</a>
			<!-- لینک‌های دسکتاپ -->
			<nav class="hidden items-center gap-0.5 md:flex" aria-label="منوی اصلی">
				for _, link := range props.NavLinks {
					@navLinkItem(link)
				}
			</nav>
			<!-- منوی موبایل بدون JS -->
			<details class="relative md:hidden ui-nav-dropdown">
				<summary
					class="ui-btn ui-btn-ghost flex h-11 w-11 list-none cursor-pointer items-center justify-center !p-0 [&::-webkit-details-marker]:hidden"
					aria-label="باز و بسته کردن منو"
				>
					<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
				</summary>
				<nav
					class="absolute left-0 top-full z-50 mt-2 w-60 rounded-xl border border-surface-border bg-white p-2 shadow-lg"
					aria-label="منوی موبایل"
				>
					for _, link := range props.NavLinks {
						@mobileNavLinkItem(link)
					}
				</nav>
			</details>
		</div>
		<script>
			document.addEventListener('click', function(e) {
				document.querySelectorAll('details.ui-nav-dropdown[open]').forEach(function(el) {
					if (!el.contains(e.target)) {
						el.removeAttribute('open');
					}
				});
			});
		</script>
	</header>
}

// navLinkItem یک آیتم نوار ناوبری دسکتاپ را (به همراه منوی کشویی در صورت وجود Children) رندر می‌کند.
templ navLinkItem(link NavLink) {
	if len(link.Children) > 0 {
		<details class="relative inline-block ui-nav-dropdown group">
			<summary
				class={ "ui-nav-item inline-flex items-center gap-1 cursor-pointer list-none select-none [&::-webkit-details-marker]:hidden", templ.KV("is-active", link.Active) }
				aria-haspopup="true"
			>
				<span>{ link.Label }</span>
				<svg class="h-4 w-4 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
				</svg>
			</summary>
			<div class="absolute right-0 top-full z-50 mt-1 min-w-52 max-w-xs rounded-xl border border-surface-border bg-white p-2 shadow-lg">
				for _, child := range link.Children {
					<a
						class={ "block rounded-lg px-3 py-2 text-sm text-ink hover:bg-surface-soft hover:text-brand transition-colors", templ.KV("bg-surface-soft text-brand font-semibold", child.Active) }
						href={ templ.SafeURL(child.Href) }
					>
						{ child.Label }
					</a>
				}
			</div>
		</details>
	} else if link.Active {
		<a
			class="ui-nav-item is-active md:inline-block"
			href={ templ.SafeURL(link.Href) }
			aria-current="page"
		>
			{ link.Label }
		</a>
	} else {
		<a
			class="ui-nav-item md:inline-block"
			href={ templ.SafeURL(link.Href) }
		>
			{ link.Label }
		</a>
	}
}

// mobileNavLinkItem یک آیتم نوار ناوبری موبایل را رندر می‌کند.
templ mobileNavLinkItem(link NavLink) {
	if len(link.Children) > 0 {
		<details class="group/sub">
			<summary class="ui-nav-item flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden">
				<span>{ link.Label }</span>
				<svg class="h-4 w-4 transition-transform duration-200 group-open/sub:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
				</svg>
			</summary>
			<div class="mr-3 mt-1 space-y-1 border-r-2 border-surface-border pr-2">
				for _, child := range link.Children {
					<a
						class={ "block rounded-lg px-3 py-1.5 text-xs text-ink-muted hover:bg-surface-soft hover:text-brand", templ.KV("text-brand font-semibold", child.Active) }
						href={ templ.SafeURL(child.Href) }
					>
						{ child.Label }
					</a>
				}
			</div>
		</details>
	} else if link.Active {
		<a
			class="ui-nav-item is-active"
			href={ templ.SafeURL(link.Href) }
			aria-current="page"
		>
			{ link.Label }
		</a>
	} else {
		<a
			class="ui-nav-item"
			href={ templ.SafeURL(link.Href) }
		>
			{ link.Label }
		</a>
	}
}

