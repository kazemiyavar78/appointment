package components

import (
	"time"
)

// NewsCardView مدل نمایش کارت خبر عمومی است.
type NewsCardView struct {
	TitleHTML       string
	ExcerptHTML     string
	CoverURL        string
	PublishedAt     time.Time
	DetailURL       string
	ClinicName      string
	ShowClinicBadge bool
}

// newsCardDate تاریخ انتشار را برای کارت فشرده قالب‌بندی می‌کند.
// ورودی: زمان انتشار. خروجی: yyyy/MM/dd یا خالی.
func newsCardDate(t time.Time) string {
	if t.IsZero() {
		return ""
	}
	return t.Format("2006/01/02")
}

// NewsCard کارت اطلاعیه فشرده موبایل‌اول را رندر می‌کند.
templ NewsCard(view NewsCardView) {
	<article class="ui-card news-card group">
		<a
			class="flex h-full min-h-[72px] items-start gap-3 p-3 outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 sm:p-3.5"
			href={ templ.SafeURL(view.DetailURL) }
		>
			<span class="news-card-media">
				if view.CoverURL != "" {
					<img
						src={ view.CoverURL }
						alt=""
						loading="lazy"
						decoding="async"
						width="64"
						height="64"
					/>
				} else {
					<span class="news-card-media-fallback" aria-hidden="true">
						<svg class="h-5 w-5 text-brand" viewBox="0 0 20 20" fill="currentColor">
							<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
						</svg>
					</span>
				}
			</span>
			<span class="flex min-w-0 flex-1 flex-col">
				<span class="mb-1 flex flex-wrap items-center gap-1.5">
					if d := newsCardDate(view.PublishedAt); d != "" {
						<time class="text-xs text-ink-faint" datetime={ view.PublishedAt.Format("2006-01-02") }>{ d }</time>
					}
					if view.ShowClinicBadge && view.ClinicName != "" {
						<span class="ui-chip">{ view.ClinicName }</span>
					}
				</span>
				<span class="news-title text-sm font-bold leading-snug text-ink">
					@templ.Raw(view.TitleHTML)
				</span>
				if view.ExcerptHTML != "" {
					<span class="news-excerpt mt-1 text-xs leading-relaxed text-ink-muted">
						@templ.Raw(view.ExcerptHTML)
					</span>
				}
			</span>
			<span class="ui-icon-btn mt-0.5 shrink-0" aria-hidden="true">
				<svg class="inline-block h-3.5 w-3.5 rotate-180 align-middle" viewBox="0 0 20 20" fill="currentColor">
					<path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"></path>
				</svg>
			</span>
		</a>
	</article>
}
