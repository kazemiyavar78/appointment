package components

import "strconv"
import "time"

// FooterLink یک لینک ناوبری در فوتر است.
type FooterLink struct {
	Label string
	Href  string
}

// FooterVariant هویت بصری فوتر هر لایه tenant را مشخص می‌کند.
type FooterVariant string

const (
	FooterPrivate  FooterVariant = "private"
	FooterOrgan    FooterVariant = "organ"
	FooterPlatform FooterVariant = "platform"
)

// FooterProps دادهٔ فوتر عمومی مشترک لایوت‌ها را نگه می‌دارد.
type FooterProps struct {
	Variant        FooterVariant
	BrandName      string
	LogoURL        string
	HomeURL        string
	Phone          string
	Address        string
	City           string
	Province       string
	BookingURL     string
	ClinicsListURL string
	ClinicLinks    []FooterLink
	CorporateLinks []FooterLink
	QuickLinks     []FooterLink
}

// footerYear سال میلادی جاری را برای خط کپی‌رایت برمی‌گرداند.
func footerYear() string {
	return strconv.Itoa(time.Now().Year())
}

// footerBrandFallback نام نمایشی را وقتی BrandName خالی است برمی‌گرداند.
func footerBrandFallback(props FooterProps) string {
	if props.BrandName != "" {
		return props.BrandName
	}
	switch props.Variant {
	case FooterOrgan:
		return "سازمان"
	case FooterPlatform:
		return "طب‌پرداز"
	default:
		return "کلینیک"
	}
}

// footerBookingURL آدرس CTA رزرو را با پیش‌فرض /doctors برمی‌گرداند.
func footerBookingURL(props FooterProps) string {
	if props.BookingURL != "" {
		return props.BookingURL
	}
	return "/doctors"
}

// footerClinicsURL آدرس فهرست مراکز را با پیش‌فرض /clinics برمی‌گرداند.
func footerClinicsURL(props FooterProps) string {
	if props.ClinicsListURL != "" {
		return props.ClinicsListURL
	}
	return "/clinics"
}

// footerShellClass کلاس پوسته بیرونی فوتر را برای هر variant برمی‌گرداند.
func footerShellClass(v FooterVariant) string {
	switch v {
	case FooterPlatform:
		return "mt-auto bg-brand-dark text-white"
	case FooterOrgan:
		return "mt-auto border-t border-surface-border bg-white text-ink"
	default:
		return "mt-auto border-t border-surface-border bg-surface-soft text-ink"
	}
}

// footerMutedClass کلاس متن کم‌رنگ فوتر را برای هر variant برمی‌گرداند.
func footerMutedClass(v FooterVariant) string {
	if v == FooterPlatform {
		return "text-white/65"
	}
	return "text-ink-muted"
}

// footerLinkClass کلاس لینک فشرده فوتر را برای هر variant برمی‌گرداند.
func footerLinkClass(v FooterVariant) string {
	if v == FooterPlatform {
		return "block min-h-[44px] py-2 text-sm text-white/80 transition hover:text-white"
	}
	return "block min-h-[44px] py-2 text-sm text-ink-muted transition hover:text-brand"
}

// footerHeadingClass کلاس عنوان بخش فوتر را برای هر variant برمی‌گرداند.
func footerHeadingClass(v FooterVariant) string {
	if v == FooterPlatform {
		return "mb-3 text-sm font-bold text-white"
	}
	return "mb-3 text-sm font-bold text-ink"
}

// footerBrandTextClass کلاس عنوان برند فوتر را برای هر variant برمی‌گرداند.
func footerBrandTextClass(v FooterVariant) string {
	if v == FooterPlatform {
		return "text-lg font-bold text-white"
	}
	return "text-lg font-bold text-ink"
}

// footerGridClass کلاس شبکه ستون‌های فوتر را برای هر variant برمی‌گرداند.
func footerGridClass(v FooterVariant) string {
	if v == FooterPrivate {
		return "site-footer-grid site-footer-grid--private"
	}
	return "site-footer-grid"
}

// footerCtaClass کلاس دکمه رزرو فوتر را برای هر variant برمی‌گرداند.
func footerCtaClass(v FooterVariant) string {
	if v == FooterPlatform {
		return "ui-btn ui-btn-primary !bg-brand-light hover:!bg-brand"
	}
	return "ui-btn ui-btn-primary"
}

// defaultCorporateLinks لینک‌های شرکتی پیش‌فرض پلتفرم را برمی‌گرداند.
func defaultCorporateLinks() []FooterLink {
	return []FooterLink{
		{Label: "درباره ما", Href: "/about"},
		{Label: "تماس با ما", Href: "/contact"},
		{Label: "قوانین و مقررات", Href: "/terms"},
	}
}

// corporateOrDefault لینک‌های شرکتی داده‌شده یا پیش‌فرض پلتفرم را برمی‌گرداند.
func corporateOrDefault(links []FooterLink) []FooterLink {
	if len(links) > 0 {
		return links
	}
	return defaultCorporateLinks()
}

// NavLinksToFooter لینک‌های نوار را به لینک‌های سریع فوتر تبدیل می‌کند.
func NavLinksToFooter(links []NavLink) []FooterLink {
	out := make([]FooterLink, 0, len(links))
	for _, link := range links {
		if link.Href != "" {
			out = append(out, FooterLink{Label: link.Label, Href: link.Href})
		}
		for _, child := range link.Children {
			if child.Href != "" {
				out = append(out, FooterLink{Label: child.Label, Href: child.Href})
			}
		}
	}
	return out
}

// Footer فوتر RTL عمومی با ستون‌های خوانا و CTA رزرو را رندر می‌کند.
templ Footer(props FooterProps) {
	<footer class={ footerShellClass(props.Variant) } dir="rtl">
		<div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
			<div class={ footerGridClass(props.Variant) }>
				<!-- Brand column -->
				<div>
					<a class="mb-3 inline-flex items-center gap-2" href={ homeHref(props.HomeURL) }>
						if props.LogoURL != "" {
							<img
								class="h-8 w-8 rounded-full object-cover"
								src={ props.LogoURL }
								alt=""
								loading="lazy"
								width="32"
								height="32"
							/>
						}
						<span class={ footerBrandTextClass(props.Variant) }>{ footerBrandFallback(props) }</span>
					</a>
					if props.Variant == FooterPrivate {
						if props.Phone != "" {
							<p class={ "text-sm", footerMutedClass(props.Variant) }>تلفن: { props.Phone }</p>
						}
						if props.Address != "" {
							<p class={ "mt-1 text-sm leading-relaxed", footerMutedClass(props.Variant) }>آدرس: { props.Address }</p>
						}
						if props.City != "" || props.Province != "" {
							<p class={ "mt-1 text-sm", footerMutedClass(props.Variant) }>
								if props.Province != "" && props.City != "" {
									{ props.Province } — { props.City }
								} else if props.Province != "" {
									{ props.Province }
								} else {
									{ props.City }
								}
							</p>
						}
						if props.Phone == "" && props.Address == "" && props.City == "" && props.Province == "" {
							<p class={ "text-sm leading-relaxed", footerMutedClass(props.Variant) }>
								نوبت‌دهی آنلاین کلینیک
							</p>
						}
					} else if props.Variant == FooterOrgan {
						<p class={ "text-sm leading-relaxed", footerMutedClass(props.Variant) }>
							دسترسی به مراکز زیرمجموعه و نوبت‌دهی آنلاین
						</p>
					} else {
						<p class={ "text-sm leading-relaxed", footerMutedClass(props.Variant) }>
							پلتفرم نوبت‌دهی مراکز درمانی
						</p>
					}
					<div class="mt-5">
						<a class={ footerCtaClass(props.Variant) } href={ templ.SafeURL(footerBookingURL(props)) }>
							نوبت بگیرید
						</a>
					</div>
				</div>
				<!-- Quick links -->
				if len(props.QuickLinks) > 0 {
					<div>
						<h3 class={ footerHeadingClass(props.Variant) }>دسترسی سریع</h3>
						<ul>
							for _, link := range props.QuickLinks {
								<li>
									<a class={ footerLinkClass(props.Variant) } href={ templ.SafeURL(link.Href) }>{ link.Label }</a>
								</li>
							}
						</ul>
					</div>
				}
				<!-- Organ clinics / Platform corporate -->
				if props.Variant == FooterOrgan {
					<div>
						<h3 class={ footerHeadingClass(props.Variant) }>مراکز</h3>
						if len(props.ClinicLinks) > 0 {
							<ul>
								for _, link := range props.ClinicLinks {
									<li>
										<a class={ footerLinkClass(props.Variant) } href={ templ.SafeURL(link.Href) }>{ link.Label }</a>
									</li>
								}
							</ul>
						}
						<a class={ "mt-1 font-medium", footerLinkClass(props.Variant) } href={ templ.SafeURL(footerClinicsURL(props)) }>
							همه مراکز
						</a>
					</div>
				}
				if props.Variant == FooterPlatform {
					<div>
						<h3 class={ footerHeadingClass(props.Variant) }>شرکت</h3>
						<ul>
							for _, link := range corporateOrDefault(props.CorporateLinks) {
								<li>
									<a class={ footerLinkClass(props.Variant) } href={ templ.SafeURL(link.Href) }>{ link.Label }</a>
								</li>
							}
						</ul>
					</div>
				}
			</div>
			if props.Variant == FooterPlatform {
				<p class="mt-8 border-t border-white/10 pt-5 text-xs text-white/50">
					© { footerYear() } { footerBrandFallback(props) }
				</p>
			} else {
				<p class="mt-8 border-t border-surface-border pt-5 text-xs text-ink-faint">
					© { footerYear() } { footerBrandFallback(props) }
				</p>
			}
			
				<p class="mt-8 border-t border-surface-border pt-5 text-xs text-ink-faint">
					<a href="https://tebpardaz.ir" target="_blank">این سایت توسط شرکت طب پرداز طراحی شده است و با استفاده از پلتفرم طب پرداز ساخته شده است </a>
				</p>
			
		</div>
	</footer>
}
