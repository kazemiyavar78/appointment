package components

// BookingStepperView دادهٔ نوار پیشرفت مراحل رزرو.
type BookingStepperView struct {
	ActiveStep int
}

// BookingStepper نوار پیشرفت ۴ مرحله‌ای رزرو را رندر می‌کند.
templ BookingStepper(view BookingStepperView) {
	<nav class="bk-stepper" aria-label="مراحل رزرو">
		<ol class="bk-stepper__list">
			<li class={ "bk-stepper__item", templ.KV("is-active", view.ActiveStep == 1), templ.KV("is-done", view.ActiveStep > 1) } data-step="1">
				<span class="bk-stepper__dot" aria-hidden="true"></span>
				<span class="bk-stepper__label">لیست نوبت‌ها</span>
			</li>
			<li class={ "bk-stepper__item", templ.KV("is-active", view.ActiveStep == 2), templ.KV("is-done", view.ActiveStep > 2) } data-step="2">
				<span class="bk-stepper__dot" aria-hidden="true"></span>
				<span class="bk-stepper__label">اطلاعات</span>
			</li>
			<li class={ "bk-stepper__item", templ.KV("is-active", view.ActiveStep == 3), templ.KV("is-done", view.ActiveStep > 3) } data-step="3">
				<span class="bk-stepper__dot" aria-hidden="true"></span>
				<span class="bk-stepper__label">کد تایید</span>
			</li>
			<li class={ "bk-stepper__item", templ.KV("is-active", view.ActiveStep == 4), templ.KV("is-done", view.ActiveStep > 4) } data-step="4">
				<span class="bk-stepper__dot" aria-hidden="true"></span>
				<span class="bk-stepper__label">اتمام</span>
			</li>
		</ol>
	</nav>
}
