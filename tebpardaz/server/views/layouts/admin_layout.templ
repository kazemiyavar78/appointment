package layouts

// AdminNavItem is one link in the admin sidebar.
type AdminNavItem struct {
	Label  string
	Href   string
	Active bool
}

// AdminLayoutView drives the admin shell (sidebar + main content).
type AdminLayoutView struct {
	NavItems []AdminNavItem
}

// AdminLayout renders the admin panel with a right-side sidebar (RTL).
templ AdminLayout(view AdminLayoutView) {
	@Document() {
		<div class="flex min-h-screen">
			<aside class="w-56 shrink-0 border-l border-gray-200 bg-white p-4">
				<h2 class="mb-4 text-lg font-semibold text-brand">پنل ادمین</h2>
				<nav class="space-y-1">
					for _, item := range view.NavItems {
						if item.Active {
							<a class="block rounded bg-brand/10 px-3 py-2 text-brand" href={ templ.SafeURL(item.Href) }>{ item.Label }</a>
						} else {
							<a class="block rounded px-3 py-2 text-ink hover:bg-surface-soft" href={ templ.SafeURL(item.Href) }>{ item.Label }</a>
						}
					}
				</nav>
				<div class="mt-8 border-t border-gray-100 pt-4">
					<a class="text-sm text-ink-muted underline" href="/admin/logout">خروج</a>
				</div>
			</aside>
			<div class="flex-1 overflow-x-auto p-4">
				{ children... }
			</div>
		</div>
	}
}
