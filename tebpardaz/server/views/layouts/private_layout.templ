package layouts

import "tebpardaz/server/views/components"

// PrivateLayoutView drives a single-clinic private public shell.
type PrivateLayoutView struct {
	ClinicName string
	LogoURL    string
	HomeURL    string
	NavLinks   []components.NavLink
	Phone      string
	Address    string
}

// PrivateLayout renders a private clinic tenant page with navbar + main content.
templ PrivateLayout(view PrivateLayoutView) {
	@Document() {
		<div class="flex min-h-screen flex-col">
			@components.Navbar(privateNavbar(view))
			<main class="flex-1 p-4">
				{ children... }
			</main>
			@components.Footer(privateFooter(view))
		</div>
	}
}

// privateNavbar maps PrivateLayoutView to NavbarProps.
func privateNavbar(view PrivateLayoutView) components.NavbarProps {
	name := view.ClinicName
	if name == "" {
		name = "کلینیک"
	}
	links := view.NavLinks
	if len(links) == 0 {
		links = defaultPublicNavLinks()
	}
	return components.NavbarProps{
		BrandName: name,
		LogoURL:   view.LogoURL,
		HomeURL:   view.HomeURL,
		NavLinks:  links,
	}
}

// privateFooter maps PrivateLayoutView to a warm single-clinic FooterProps.
func privateFooter(view PrivateLayoutView) components.FooterProps {
	nav := privateNavbar(view)
	return components.FooterProps{
		Variant:    components.FooterPrivate,
		BrandName:  nav.BrandName,
		LogoURL:    view.LogoURL,
		HomeURL:    view.HomeURL,
		Phone:      view.Phone,
		Address:    view.Address,
		BookingURL: "/doctors",
		QuickLinks: components.NavLinksToFooter(nav.NavLinks),
	}
}
