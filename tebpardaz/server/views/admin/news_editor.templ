package admin

import (
	"tebpardaz/server/views/layouts"
)

// NewsEditorView drives the create/edit news form.
type NewsEditorView struct {
	Nav            layouts.AdminLayoutView
	Message        string
	EditID         uint
	ClinicID       uint
	TitleHTML      string
	ExcerptHTML    string
	CoverURL       string
	BodyHTML       string
	IsPublished    bool
	FormAction     string
	Clinics        []ClinicOption
	ShowClinicPick bool
}

// NewsEditor renders the rich-text news create/edit form.
templ NewsEditor(view NewsEditorView) {
	@layouts.AdminLayout(view.Nav) {
		<div class="mx-auto max-w-3xl">
			<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
				if view.EditID > 0 {
					<h1 class="ui-page-title">ویرایش خبر</h1>
				} else {
					<h1 class="ui-page-title">ایجاد خبر</h1>
				}
				<a class="ui-btn ui-btn-ghost" href="/admin/news">بازگشت به لیست</a>
			</div>
			if view.Message != "" {
				<p class="ui-panel mb-3 text-sm text-ink-muted">{ view.Message }</p>
			}
			<form id="news-form" class="ui-panel space-y-4" method="post" action={ templ.SafeURL(view.FormAction) }>
				if view.ShowClinicPick {
					<label class="block text-sm text-ink-muted">
						مرکز
						<select class="ui-field mt-1" name="clinic_id" required>
							<option value="">انتخاب مرکز...</option>
							for _, clinic := range view.Clinics {
								if clinic.Selected {
									<option value={ formatUint(clinic.ID) } selected>{ clinic.Name }</option>
								} else {
									<option value={ formatUint(clinic.ID) }>{ clinic.Name }</option>
								}
							}
						</select>
					</label>
				} else if view.ClinicID > 0 {
					<input type="hidden" name="clinic_id" value={ formatUint(view.ClinicID) }/>
					if len(view.Clinics) > 0 {
						<p class="text-sm text-ink-muted">مرکز: <span class="text-ink">{ view.Clinics[0].Name }</span></p>
					}
				}

				<div>
					<label class="mb-1 block text-sm text-ink-muted">تصویر اصلی کارت خبر</label>
					<div class="flex flex-wrap items-center gap-3">
						<input type="hidden" id="cover_url" name="cover_url" value={ view.CoverURL }/>
						<input id="cover_file" class="block text-sm" type="file" accept="image/*"/>
						<button class="ui-btn ui-btn-ghost" type="button" id="cover_clear">حذف تصویر</button>
					</div>
					<img
						id="cover_preview"
						class={ "mt-2 h-40 w-full max-w-md rounded object-cover", templ.KV("hidden", view.CoverURL == "") }
						src={ view.CoverURL }
						alt="پیش‌نمایش تصویر"
					/>
				</div>

				<div>
					<label class="mb-1 block text-sm text-ink-muted">عنوان خبر</label>
					@richToolbar("title")
					<div
						id="title_editor"
						class="min-h-[2.5rem] rounded border border-gray-300 p-2 text-lg"
						contenteditable="true"
						data-placeholder="عنوان خبر"
					>
						@templ.Raw(view.TitleHTML)
					</div>
					<input type="hidden" id="title" name="title" value=""/>
				</div>

				<div>
					<label class="mb-1 block text-sm text-ink-muted">خلاصه کارت (حداکثر حدود ۵۰ تا ۱۲۰ کاراکتر)</label>
					@richToolbar("excerpt")
					<div
						id="excerpt_editor"
						class="min-h-[3rem] rounded border border-gray-300 p-2 text-sm"
						contenteditable="true"
						data-placeholder="متن کوتاه برای کارت خبر"
					>
						@templ.Raw(view.ExcerptHTML)
					</div>
					<input type="hidden" id="excerpt" name="excerpt" value=""/>
					<p class="mt-1 text-xs text-ink-muted">طول متن خالص: <span id="excerpt_len">0</span> کاراکتر</p>
				</div>

				<div>
					<label class="mb-1 block text-sm text-ink-muted">شرح خبر</label>
					@richToolbar("body")
					<div
						id="body_editor"
						class="min-h-[16rem] rounded border border-gray-300 p-3 prose max-w-none"
						contenteditable="true"
						data-placeholder="متن کامل خبر — می‌توانید متن و چند تصویر اضافه کنید"
					>
						@templ.Raw(view.BodyHTML)
					</div>
					<input type="hidden" id="body" name="body" value=""/>
					<div class="mt-2">
						<label class="inline-flex cursor-pointer items-center gap-2 text-sm text-brand">
							<input id="body_image_file" class="hidden" type="file" accept="image/*"/>
							<span class="rounded border border-brand px-3 py-1">درج تصویر در شرح</span>
						</label>
					</div>
				</div>

				<label class="flex items-center gap-2 text-sm text-ink-muted">
					if view.IsPublished {
						<input type="checkbox" name="is_published" value="1" checked/>
					} else {
						<input type="checkbox" name="is_published" value="1"/>
					}
					منتشر شود
				</label>

				<button class="ui-btn ui-btn-primary" type="submit">ذخیره خبر</button>
			</form>
		</div>
		<script>
			(function () {
				function exec(cmd, val) {
					document.execCommand(cmd, false, val || null);
				}
				function bindToolbar(prefix) {
					var bar = document.getElementById('toolbar_' + prefix);
					if (!bar) return;
					bar.addEventListener('click', function (e) {
						var btn = e.target.closest('[data-cmd]');
						if (!btn) return;
						e.preventDefault();
						var editor = document.getElementById(prefix + '_editor');
						if (editor) editor.focus();
						var cmd = btn.getAttribute('data-cmd');
						if (cmd === 'foreColor') {
							var color = bar.querySelector('[data-color]').value;
							exec('foreColor', color);
							return;
						}
						if (cmd === 'fontSize') {
							exec('fontSize', '5');
							return;
						}
						exec(cmd);
					});
				}
				['title', 'excerpt', 'body'].forEach(bindToolbar);

				function plainLen(html) {
					var d = document.createElement('div');
					d.innerHTML = html || '';
					return (d.textContent || '').trim().length;
				}
				function updateExcerptLen() {
					var el = document.getElementById('excerpt_editor');
					var out = document.getElementById('excerpt_len');
					if (el && out) out.textContent = String(plainLen(el.innerHTML));
				}
				var excerptEditor = document.getElementById('excerpt_editor');
				if (excerptEditor) {
					excerptEditor.addEventListener('input', updateExcerptLen);
					updateExcerptLen();
				}

				async function uploadFile(file) {
					var fd = new FormData();
					fd.append('file', file);
					var res = await fetch('/admin/news/upload', { method: 'POST', body: fd });
					var data = await res.json();
					if (!res.ok) throw new Error(data.error || 'upload failed');
					return data.url;
				}

				var coverFile = document.getElementById('cover_file');
				var coverURL = document.getElementById('cover_url');
				var coverPreview = document.getElementById('cover_preview');
				if (coverFile) {
					coverFile.addEventListener('change', async function () {
						if (!coverFile.files || !coverFile.files[0]) return;
						try {
							var url = await uploadFile(coverFile.files[0]);
							coverURL.value = url;
							coverPreview.src = url;
							coverPreview.classList.remove('hidden');
						} catch (err) {
							alert(err.message || 'آپلود تصویر ناموفق بود.');
						}
					});
				}
				var coverClear = document.getElementById('cover_clear');
				if (coverClear) {
					coverClear.addEventListener('click', function () {
						coverURL.value = '';
						coverPreview.src = '';
						coverPreview.classList.add('hidden');
						if (coverFile) coverFile.value = '';
					});
				}

				var bodyImage = document.getElementById('body_image_file');
				if (bodyImage) {
					bodyImage.addEventListener('change', async function () {
						if (!bodyImage.files || !bodyImage.files[0]) return;
						try {
							var url = await uploadFile(bodyImage.files[0]);
							var editor = document.getElementById('body_editor');
							if (editor) editor.focus();
							exec('insertHTML', '<img src="' + url + '" alt="" style="max-width:100%;height:auto;margin:0.75rem 0;">');
						} catch (err) {
							alert(err.message || 'آپلود تصویر ناموفق بود.');
						}
						bodyImage.value = '';
					});
				}

				var form = document.getElementById('news-form');
				if (form) {
					form.addEventListener('submit', function () {
						document.getElementById('title').value = document.getElementById('title_editor').innerHTML;
						document.getElementById('excerpt').value = document.getElementById('excerpt_editor').innerHTML;
						document.getElementById('body').value = document.getElementById('body_editor').innerHTML;
					});
				}
			})();
		</script>
	}
}

// richToolbar renders formatting controls for a contenteditable field.
templ richToolbar(prefix string) {
	<div id={ "toolbar_" + prefix } class="mb-1 flex flex-wrap items-center gap-1 rounded border border-gray-200 bg-surface-soft p-1">
		<button class="rounded border border-gray-300 bg-white px-2 py-1 text-xs font-bold" type="button" data-cmd="bold" title="بولد">B</button>
		<button class="rounded border border-gray-300 bg-white px-2 py-1 text-xs underline" type="button" data-cmd="underline" title="زیرخط">U</button>
		<button class="rounded border border-gray-300 bg-white px-2 py-1 text-xs" type="button" data-cmd="fontSize" title="بزرگ‌تر">A+</button>
		<input class="h-7 w-8 cursor-pointer rounded border border-gray-300" type="color" data-color value="#1f2937" title="رنگ"/>
		<button class="rounded border border-gray-300 bg-white px-2 py-1 text-xs" type="button" data-cmd="foreColor" title="اعمال رنگ">رنگ</button>
	</div>
}
