package admin

import (
	"strings"
	"tebpardaz/server/views/layouts"
)

// ServiceAssignOption یک آیتم چک‌باکس خدمت برای انتصاب است.
type ServiceAssignOption struct {
	ID          uint
	Name        string
	Description string
	Packages    []string
	Selected    bool
}

// serviceAssignSearchText متن جستجوی یک خدمت را از نام، توضیحات و بسته‌ها می‌سازد.
// ورودی: item گزینه خدمت. خروجی: متن کوچک‌شده برای فیلتر سمت کلاینت.
func serviceAssignSearchText(item ServiceAssignOption) string {
	return strings.ToLower(item.Name + " " + item.Description + " " + strings.Join(item.Packages, " "))
}

// serviceAssignLabel نام خدمت و بسته‌های عضو آن را در لیست جستجوی انتصاب نشان می‌دهد.
// ورودی: item گزینه خدمت. خروجی: بلوک متن کنار چک‌باکس.
templ serviceAssignLabel(item ServiceAssignOption) {
	<div class="min-w-0 flex-1">
		<span class="text-xs font-semibold text-ink block">{ item.Name }</span>
		if len(item.Packages) > 0 {
			<div class="mt-1 flex flex-wrap gap-1">
				for _, name := range item.Packages {
					<span class="inline-block rounded-full bg-white/10 px-2 py-0.5 text-[11px] font-medium text-white">{ name }</span>
				}
			</div>
		}
		if item.Description != "" {
			<span class="text-[11px] text-ink-muted block mt-0.5">{ item.Description }</span>
		}
	</div>
}

// InsuranceOption یک گزینه در لیست انتخاب بیمه است.
type InsuranceOption struct {
	ID       uint
	Name     string
	Selected bool
}

// ClinicInsuranceServicesView مدل داده صفحه انتصاب خدمات به بیمه‌های مرکز است.
type ClinicInsuranceServicesView struct {
	Nav                 layouts.AdminLayoutView
	Message             string
	Clinics             []ClinicOption
	SelectedClinicID    uint
	Insurances          []InsuranceOption
	SelectedInsuranceID uint
	Services            []ServiceAssignOption
}

// ClinicInsuranceServices صفحه انتصاب خدمات به بیمه‌های انتخابی مرکز را رندر می‌کند.
// ورودی: view مدل داده صفحه انتصاب. خروجی: کامپوننت templ صفحه ادمین.
templ ClinicInsuranceServices(view ClinicInsuranceServicesView) {
	@layouts.AdminLayout(view.Nav) {
		<div class="mx-auto max-w-5xl">
			<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
				<div>
					<h1 class="ui-page-title">انتصاب خدمات به بیمه‌های مرکز</h1>
					<p class="mt-1 text-xs text-ink-muted">
						مشخص کنید بیمه‌های طرف قرارداد مرکز، چه خدماتی را تحت پوشش قرار می‌دهند.
					</p>
				</div>
				<a class="ui-btn ui-btn-ghost text-xs" href="/admin/services">
					<i class="fa-solid fa-arrow-right ml-1"></i>
					بازگشت به لیست خدمات
				</a>
			</div>
			if view.Message != "" {
				<div class="ui-panel mb-4 text-sm font-medium text-brand-dark bg-brand/5 border border-brand/20">
					{ view.Message }
				</div>
			}

			<!-- انتخاب مرکز درمانی -->
			<div class="mb-6 rounded-xl border border-surface-border bg-white p-4 shadow-sm">
				<form class="flex flex-wrap items-end gap-3" method="get" action="/admin/services/clinic-insurances">
					<label class="block text-xs font-semibold text-ink-muted">
						مرکز درمانی
						<select class="ui-field mt-1.5 min-w-[14rem] text-sm" name="clinic_id" onchange="this.form.submit()" required>
							<option value="">-- انتخاب مرکز درمانی --</option>
							for _, clinic := range view.Clinics {
								<option value={ formatUint(clinic.ID) } selected?={ clinic.Selected }>{ clinic.Name }</option>
							}
						</select>
					</label>
					<noscript>
						<button class="ui-btn ui-btn-ghost text-xs" type="submit">انتخاب مرکز</button>
					</noscript>
				</form>
			</div>

			if view.SelectedClinicID == 0 {
				<div class="ui-panel text-center py-10 text-sm text-ink-muted">
					<i class="fa-solid fa-hospital text-3xl mb-2 text-gray-300 block"></i>
					لطفاً برای مدیریت پوشش خدمات بیمه‌ها، ابتدا یک مرکز درمانی را انتخاب نمایید.
				</div>
			} else if len(view.Insurances) == 0 {
				<div class="ui-panel text-center py-8 text-sm text-ink-muted">
					<i class="fa-solid fa-shield-halved text-3xl mb-2 text-gray-300 block"></i>
					<p class="mb-3">هنوز هیچ بیمه‌ای به این مرکز درمانی منتسب نشده است.</p>
					<a class="ui-btn ui-btn-primary text-xs inline-flex items-center gap-1.5" href={ templ.SafeURL("/admin/insurances/assign?clinic_id=" + formatUint(view.SelectedClinicID)) }>
						<i class="fa-solid fa-plus"></i>
						انتصاب بیمه به این مرکز
					</a>
				</div>
			} else if len(view.Services) == 0 {
				<div class="ui-panel text-center py-8 text-sm text-ink-muted">
					<i class="fa-solid fa-list-check text-3xl mb-2 text-gray-300 block"></i>
					هنوز هیچ خدمتی در کاتالوگ خدمات سامانه ثبت نشده است.
				</div>
			} else {
				<form method="post" action="/admin/services/clinic-insurances" id="clinic-insurance-services-form" onsubmit="return validateClinicInsuranceServicesForm()">
					<input type="hidden" name="clinic_id" value={ formatUint(view.SelectedClinicID) }/>

					<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
						<!-- ستون انتخاب بیمه‌ها -->
						<div class="flex flex-col rounded-xl border border-surface-border bg-white p-4 shadow-sm h-[520px]">
							<div class="flex items-center justify-between pb-3 border-b border-gray-100">
								<div class="flex items-center gap-2">
									<i class="fa-solid fa-shield-halved text-brand text-sm"></i>
									<h2 class="text-sm font-bold text-ink">انتخاب بیمه(ها)</h2>
								</div>
								<span id="ins-selected-badge" class="rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-semibold text-blue-700">
									۰ بیمه انتخاب شده
								</span>
							</div>

							<!-- جستجوی بیمه -->
							<div class="mt-3 relative">
								<input
									type="search"
									id="ins-search-input"
									placeholder="جستجوی نام بیمه..."
									oninput="filterInsItems()"
									class="ui-field w-full pr-8 text-xs bg-gray-50/60 focus:bg-white"
								/>
								<i class="fa-solid fa-magnifying-glass absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-400 text-xs pointer-events-none"></i>
							</div>

							<!-- دکمه‌های اقدام سریع بیمه‌ها -->
							<div class="flex items-center justify-between mt-2 pt-2 border-t border-gray-100 text-xs">
								<button type="button" onclick="toggleAllInsurances(true)" class="text-brand hover:underline font-medium">
									انتخاب همه
								</button>
								<button type="button" onclick="toggleAllInsurances(false)" class="text-ink-muted hover:underline">
									لغو انتخاب همه
								</button>
							</div>

							<!-- لیست اسکرول‌شونده بیمه‌ها -->
							<div id="ins-list-container" class="mt-2 flex-1 overflow-y-auto space-y-1 pr-1">
								for _, ins := range view.Insurances {
									<label class="ins-item flex items-center gap-2.5 p-2 rounded-lg hover:bg-gray-50 border border-transparent hover:border-gray-100 cursor-pointer transition-colors" data-search={ strings.ToLower(ins.Name) }>
										<input
											type="checkbox"
											name="insurance_ids"
											value={ formatUint(ins.ID) }
											onchange="updateInsCount()"
											class="ins-checkbox h-4 w-4 rounded border-gray-300 text-brand focus:ring-brand"
											checked?={ ins.Selected }
										/>
										<span class="text-xs font-medium text-ink">{ ins.Name }</span>
									</label>
								}
								<p id="ins-empty-msg" class="hidden text-center text-xs text-ink-muted py-8">
									بیمه‌ای مطابق با عبارت جستجو یافت نشد.
								</p>
							</div>
						</div>

						<!-- ستون انتخاب خدمات -->
						<div class="flex flex-col rounded-xl border border-surface-border bg-white p-4 shadow-sm h-[520px]">
							<div class="flex items-center justify-between pb-3 border-b border-gray-100">
								<div class="flex items-center gap-2">
									<i class="fa-solid fa-list-check text-brand text-sm"></i>
									<h2 class="text-sm font-bold text-ink">انتخاب خدمات تحت پوشش</h2>
								</div>
								<span id="srv-selected-badge" class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700">
									۰ خدمت انتخاب شده
								</span>
							</div>

							<!-- جستجوی خدمت -->
							<div class="mt-3 relative">
								<input
									type="search"
									id="srv-search-input"
									placeholder="جستجوی خدمت بر اساس عنوان یا شرح..."
									oninput="filterSrvItems()"
									class="ui-field w-full pr-8 text-xs bg-gray-50/60 focus:bg-white"
								/>
								<i class="fa-solid fa-magnifying-glass absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-400 text-xs pointer-events-none"></i>
							</div>

							<!-- دکمه‌های اقدام سریع خدمات -->
							<div class="flex items-center justify-between mt-2 pt-2 border-t border-gray-100 text-xs">
								<button type="button" onclick="toggleAllSrvs(true)" class="text-white hover:underline font-medium">
									انتخاب همه
								</button>
								<button type="button" onclick="toggleAllSrvs(false)" class="text-ink-muted hover:underline">
									لغو انتخاب همه
								</button>
							</div>

							<!-- لیست اسکرول‌شونده خدمات -->
							<div id="srv-list-container" class="mt-2 flex-1 overflow-y-auto space-y-1.5 pr-1 divide-y divide-gray-50">
								for _, item := range view.Services {
									<label class="srv-item flex items-start gap-2.5 p-2 rounded-lg hover:bg-gray-50 border border-transparent hover:border-gray-100 cursor-pointer transition-colors" data-search={ serviceAssignSearchText(item) }>
										<input
											type="checkbox"
											name="service_ids"
											value={ formatUint(item.ID) }
											onchange="updateSrvCount()"
											class="srv-checkbox mt-0.5 h-4 w-4 rounded border-gray-300 text-brand focus:ring-brand"
											checked?={ item.Selected }
										/>
										@serviceAssignLabel(item)
									</label>
								}
								<p id="srv-empty-msg" class="hidden text-center text-xs text-ink-muted py-8">
									خدمتی مطابق با عبارت جستجو یافت نشد.
								</p>
							</div>
						</div>
					</div>

					<!-- نوار دکمه ذخیره -->
					<div class="mt-5 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-surface-border bg-white p-4 shadow-sm">
						<div class="text-xs text-ink-muted leading-relaxed">
							<i class="fa-solid fa-circle-info text-brand ml-1"></i>
							با ذخیره اطلاعات، خدمات مشخص‌شده به تمام بیمه‌های انتخاب‌شده در بالا اختصاص می‌یابند.
						</div>
						<button class="ui-btn ui-btn-primary text-xs px-6 py-2.5 font-semibold" type="submit">
							<i class="fa-solid fa-floppy-disk ml-1.5"></i>
							ذخیره انتصاب خدمات
						</button>
					</div>
				</form>

				<script>
					function toPersianDigits(n) {
						var id = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];
						return String(n).replace(/[0-9]/g, function(w){ return id[+w]; });
					}

					function updateInsCount() {
						var checked = document.querySelectorAll('.ins-checkbox:checked').length;
						var badge = document.getElementById('ins-selected-badge');
						if (badge) {
							badge.textContent = toPersianDigits(checked) + ' بیمه انتخاب شده';
						}
					}

					function filterInsItems() {
						var q = (document.getElementById('ins-search-input').value || '').trim().toLowerCase();
						var items = document.querySelectorAll('.ins-item');
						var visibleCount = 0;
						items.forEach(function(item) {
							var text = item.getAttribute('data-search') || '';
							if (!q || text.indexOf(q) !== -1) {
								item.style.display = '';
								visibleCount++;
							} else {
								item.style.display = 'none';
							}
						});
						var emptyMsg = document.getElementById('ins-empty-msg');
						if (emptyMsg) {
							emptyMsg.classList.toggle('hidden', visibleCount > 0);
						}
					}

					function toggleAllInsurances(checked) {
						var items = document.querySelectorAll('.ins-item');
						items.forEach(function(item) {
							if (item.style.display !== 'none') {
								var cb = item.querySelector('.ins-checkbox');
								if (cb) cb.checked = checked;
							}
						});
						updateInsCount();
					}

					function updateSrvCount() {
						var checked = document.querySelectorAll('.srv-checkbox:checked').length;
						var badge = document.getElementById('srv-selected-badge');
						if (badge) {
							badge.textContent = toPersianDigits(checked) + ' خدمت انتخاب شده';
						}
					}

					function filterSrvItems() {
						var q = (document.getElementById('srv-search-input').value || '').trim().toLowerCase();
						var items = document.querySelectorAll('.srv-item');
						var visibleCount = 0;
						items.forEach(function(item) {
							var text = item.getAttribute('data-search') || '';
							if (!q || text.indexOf(q) !== -1) {
								item.style.display = '';
								visibleCount++;
							} else {
								item.style.display = 'none';
							}
						});
						var emptyMsg = document.getElementById('srv-empty-msg');
						if (emptyMsg) {
							emptyMsg.classList.toggle('hidden', visibleCount > 0);
						}
					}

					function toggleAllSrvs(checked) {
						var items = document.querySelectorAll('.srv-item');
						items.forEach(function(item) {
							if (item.style.display !== 'none') {
								var cb = item.querySelector('.srv-checkbox');
								if (cb) cb.checked = checked;
							}
						});
						updateSrvCount();
					}

					function validateClinicInsuranceServicesForm() {
						var insChecked = document.querySelectorAll('.ins-checkbox:checked').length;
						if (insChecked === 0) {
							alert('لطفاً حداقل یک بیمه را برای انتصاب خدمات انتخاب نمایید.');
							return false;
						}
						return true;
					}

					document.addEventListener('DOMContentLoaded', function() {
						updateInsCount();
						updateSrvCount();
					});
					updateInsCount();
					updateSrvCount();
				</script>
			}
		</div>
	}
}
