package admin

import (
	"strconv"
	"time"

	"tebpardaz/server/views/layouts"
)

// NewsListRow is one news item in the admin table.
type NewsListRow struct {
	ID          uint
	TitlePlain  string
	ClinicName  string
	CoverURL    string
	IsPublished bool
	PublishedAt time.Time
}

// NewsListView is the admin news list page model.
type NewsListView struct {
	Nav     layouts.AdminLayoutView
	Message string
	Items   []NewsListRow
}

func newsPublishedLabel(published bool) string {
	if published {
		return "منتشر شده"
	}
	return "پیش‌نویس"
}

func newsFormatDate(t time.Time) string {
	if t.IsZero() {
		return "—"
	}
	return t.Format("2006/01/02 15:04")
}

// NewsList renders the admin news list with create/edit/delete actions.
templ NewsList(view NewsListView) {
	@layouts.AdminLayout(view.Nav) {
		<div class="mx-auto max-w-5xl">
			<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
				<h1 class="text-2xl text-brand">مدیریت اخبار</h1>
				<a class="rounded bg-brand px-4 py-2 text-white" href="/admin/news/new">ایجاد خبر جدید</a>
			</div>
			if view.Message != "" {
				<p class="mb-3 rounded border border-gray-200 bg-white px-3 py-2 text-sm text-ink-muted">{ view.Message }</p>
			}
			<section>
				<div class="overflow-x-auto">
					<table class="w-full min-w-[720px] border border-gray-200 bg-white text-sm">
						<thead>
							<tr class="border-b border-gray-200 bg-surface-soft text-right">
								<th class="p-2">ردیف</th>
								<th class="p-2">تصویر</th>
								<th class="p-2">عنوان</th>
								<th class="p-2">مرکز</th>
								<th class="p-2">وضعیت</th>
								<th class="p-2">تاریخ</th>
								<th class="p-2">اقدام</th>
							</tr>
						</thead>
						<tbody>
							if len(view.Items) == 0 {
								<tr>
									<td class="p-3 text-ink-muted" colspan="7">خبری ثبت نشده است.</td>
								</tr>
							}
							for index, item := range view.Items {
								<tr class="border-b border-gray-100">
									<td class="p-2">{ strconv.Itoa(index + 1) }</td>
									<td class="p-2">
										if item.CoverURL != "" {
											<img class="h-12 w-16 rounded object-cover" src={ item.CoverURL } alt=""/>
										} else {
											<span class="text-ink-muted">—</span>
										}
									</td>
									<td class="p-2">{ item.TitlePlain }</td>
									<td class="p-2">{ item.ClinicName }</td>
									<td class="p-2">{ newsPublishedLabel(item.IsPublished) }</td>
									<td class="p-2 whitespace-nowrap">{ newsFormatDate(item.PublishedAt) }</td>
									<td class="p-2 whitespace-nowrap">
										<a
											class="ml-2 rounded border border-gray-300 px-2 py-1 text-xs"
											href={ templ.SafeURL("/admin/news/" + formatUint(item.ID) + "/edit") }
										>ویرایش</a>
										<form class="inline" method="post" action={ templ.SafeURL("/admin/news/" + formatUint(item.ID) + "/delete") } onsubmit="return confirm('این خبر حذف شود؟');">
											<button class="rounded border border-red-300 px-2 py-1 text-xs text-red-700" type="submit">حذف</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		</div>
	}
}
