package admin

import (
	"strconv"

	"tebpardaz/server/views/layouts"
	"tebpardaz/shared/constants"
)

// UserSelectOption is a clinic or organization option in the user form.
type UserSelectOption struct {
	ID   uint
	Name string
}

// UserRow is one appointment user in the admin table.
type UserRow struct {
	ID         uint
	Username   string
	Role       string
	RoleLabel  string
	ScopeLabel string
	IsActive   bool
	IsSelf     bool
}

// UsersPageView is the full page model for user management.
type UsersPageView struct {
	Nav                layouts.AdminLayoutView
	Items              []UserRow
	Clinics            []UserSelectOption
	Organizations      []UserSelectOption
	Message            string
	EditID             uint
	EditUsername       string
	EditRole           string
	EditClinicID       uint
	EditOrganizationID uint
	EditIsActive       bool
}

func userActiveLabel(active bool) string {
	if active {
		return "فعال"
	}
	return "غیرفعال"
}

func roleSelected(current, value string) bool {
	return current == value
}

func uintSelected(current, value uint) bool {
	return current == value && value > 0
}

func defaultRole(role string) string {
	if role == "" {
		return string(constants.UserRoleClinicAdmin)
	}
	return role
}

// Users renders list, create, update, activate, and deactivate on one page.
templ Users(view UsersPageView) {
	@layouts.AdminLayout(view.Nav) {
		<div class="mx-auto max-w-5xl">
			<h1 class="mb-4 text-2xl text-brand">مدیریت کاربران</h1>
			if view.Message != "" {
				<p class="mb-3 rounded border border-gray-200 bg-white px-3 py-2 text-sm text-ink-muted">{ view.Message }</p>
			}
			<section class="mb-6 rounded border border-gray-200 bg-white p-4">
				if view.EditID > 0 {
					<h2 class="mb-3 text-lg text-ink">بروزرسانی کاربر</h2>
					<form class="flex flex-wrap items-end gap-3" method="post" action={ templ.SafeURL("/admin/users/" + formatUint(view.EditID) + "/update") } id="user-form">
						@userFormFields(view)
						<button class="rounded bg-brand px-4 py-2 text-white" type="submit">ذخیره تغییرات</button>
						<a class="rounded border border-gray-300 px-4 py-2 text-sm" href="/admin/users">انصراف</a>
					</form>
				} else {
					<h2 class="mb-3 text-lg text-ink">ایجاد کاربر</h2>
					<form class="flex flex-wrap items-end gap-3" method="post" action="/admin/users" id="user-form">
						@userFormFields(view)
						<button class="rounded bg-brand px-4 py-2 text-white" type="submit">ایجاد</button>
					</form>
				}
			</section>
			<section>
				<h2 class="mb-3 text-lg text-ink">لیست کاربران</h2>
				<div class="overflow-x-auto">
					<table class="w-full min-w-[720px] border border-gray-200 bg-white text-sm">
						<thead>
							<tr class="border-b border-gray-200 bg-surface-soft text-right">
								<th class="p-2">ردیف</th>
								<th class="p-2">نام کاربری</th>
								<th class="p-2">نقش</th>
								<th class="p-2">محدوده</th>
								<th class="p-2">وضعیت</th>
								<th class="p-2">اقدام</th>
							</tr>
						</thead>
						<tbody>
							if len(view.Items) == 0 {
								<tr>
									<td class="p-3 text-ink-muted" colspan="6">کاربری ثبت نشده است.</td>
								</tr>
							}
							for index, item := range view.Items {
								<tr class="border-b border-gray-100">
									<td class="p-2">{ strconv.Itoa(index + 1) }</td>
									<td class="p-2">{ item.Username }</td>
									<td class="p-2">{ item.RoleLabel }</td>
									<td class="p-2">{ item.ScopeLabel }</td>
									<td class="p-2">{ userActiveLabel(item.IsActive) }</td>
									<td class="p-2 whitespace-nowrap">
										<a
											class="ml-2 rounded border border-gray-300 px-2 py-1 text-xs"
											href={ templ.SafeURL("/admin/users?edit=" + formatUint(item.ID)) }
										>ویرایش</a>
										if item.IsActive {
											if !item.IsSelf {
												<form class="inline" method="post" action={ templ.SafeURL("/admin/users/" + formatUint(item.ID) + "/deactivate") } onsubmit="return confirm('این کاربر غیرفعال شود؟');">
													<button class="rounded border border-red-300 px-2 py-1 text-xs text-red-700" type="submit">غیرفعال</button>
												</form>
											}
										} else {
											<form class="inline" method="post" action={ templ.SafeURL("/admin/users/" + formatUint(item.ID) + "/activate") }>
												<button class="rounded border border-green-300 px-2 py-1 text-xs text-green-700" type="submit">فعال‌سازی</button>
											</form>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
			<script>
				(function () {
					var role = document.getElementById("user-role");
					var clinicWrap = document.getElementById("clinic-field");
					var orgWrap = document.getElementById("org-field");
					if (!role || !clinicWrap || !orgWrap) return;
					function sync() {
						var v = role.value;
						clinicWrap.style.display = v === "clinic_admin" ? "" : "none";
						orgWrap.style.display = v === "organ_admin" ? "" : "none";
					}
					role.addEventListener("change", sync);
					sync();
				})();
			</script>
		</div>
	}
}

templ userFormFields(view UsersPageView) {
	<label class="block text-sm text-ink-muted">
		نام کاربری
		<input class="mt-1 block w-48 rounded border border-gray-300 p-2" type="text" name="username" value={ view.EditUsername } required maxlength="100"/>
	</label>
	<label class="block text-sm text-ink-muted">
		if view.EditID > 0 {
			رمز عبور (اختیاری)
		} else {
			رمز عبور
		}
		if view.EditID > 0 {
			<input class="mt-1 block w-48 rounded border border-gray-300 p-2" type="password" name="password" maxlength="100" autocomplete="new-password"/>
		} else {
			<input class="mt-1 block w-48 rounded border border-gray-300 p-2" type="password" name="password" required maxlength="100" autocomplete="new-password"/>
		}
	</label>
	<label class="block text-sm text-ink-muted">
		نقش
		<select class="mt-1 block w-48 rounded border border-gray-300 p-2" name="role" id="user-role">
			<option value="superadmin" selected?={ roleSelected(defaultRole(view.EditRole), "superadmin") }>سوپر ادمین</option>
			<option value="clinic_admin" selected?={ roleSelected(defaultRole(view.EditRole), "clinic_admin") }>ادمین کلینیک</option>
			<option value="organ_admin" selected?={ roleSelected(defaultRole(view.EditRole), "organ_admin") }>ادمین ارگان</option>
		</select>
	</label>
	<label class="block text-sm text-ink-muted" id="clinic-field">
		کلینیک
		<select class="mt-1 block w-56 rounded border border-gray-300 p-2" name="clinic_id">
			<option value="">انتخاب کنید</option>
			for _, clinic := range view.Clinics {
				<option value={ formatUint(clinic.ID) } selected?={ uintSelected(view.EditClinicID, clinic.ID) }>{ clinic.Name }</option>
			}
		</select>
	</label>
	<label class="block text-sm text-ink-muted" id="org-field">
		ارگان
		<select class="mt-1 block w-56 rounded border border-gray-300 p-2" name="organization_id">
			<option value="">انتخاب کنید</option>
			for _, org := range view.Organizations {
				<option value={ formatUint(org.ID) } selected?={ uintSelected(view.EditOrganizationID, org.ID) }>{ org.Name }</option>
			}
		</select>
	</label>
}
