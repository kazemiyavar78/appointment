package admin

import (
	"strconv"
	"tebpardaz/server/views/layouts"
)

// EquipmentRow represents an equipment introduction item in the admin list.
type EquipmentRow struct {
	ID         uint
	Title      string
	QuoteTitle string
	Badge      string
	ImageURL   string
	Tags       string
	SortOrder  int
	IsActive   bool
}

// SectionEquipmentView holds view model for managing equipment items.
type SectionEquipmentView struct {
	Nav             layouts.AdminLayoutView
	SectionID       uint
	SectionTitle    string
	ClinicID        uint
	Items           []EquipmentRow
	Message         string
	EditID          uint
	EditQuoteTitle  string
	EditQuoteText   string
	EditBadge       string
	EditImageURL    string
	EditTitle       string
	EditSubtitle    string
	EditDescription string
	EditTags        string
	EditButtonText  string
	EditButtonURL   string
	EditSortOrder   int
	EditIsActive    bool
}

// SectionEquipment renders the list and creation/edit form of equipment introduction items.
templ SectionEquipment(view SectionEquipmentView) {
	@layouts.AdminLayout(view.Nav) {
		<div class="mx-auto max-w-5xl">
			<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
				<div>
					<div class="flex items-center gap-2 text-sm text-ink-muted mb-1">
						<a class="hover:text-brand" href={ templ.SafeURL("/admin/sections?clinic_id=" + formatUint(view.ClinicID)) }>بخش‌های مرکز</a>
						<span>/</span>
						<span>{ view.SectionTitle }</span>
					</div>
					<h1 class="ui-page-title">معرفی تجهیزات بخش: { view.SectionTitle }</h1>
					<p class="text-xs text-ink-muted mt-1">تعریف کارت‌های معرفی تجهیزات و تکنولوژی‌ها (شامل باکس نقل‌قول + قالب دو ستونی تصویر و توضیحات)</p>
				</div>
				<div class="flex items-center gap-2">
					<a class="ui-btn ui-btn-ghost text-xs" href={ templ.SafeURL("/admin/sections/" + formatUint(view.SectionID) + "/banner") }>بنر</a>
					<a class="ui-btn ui-btn-ghost text-xs" href={ templ.SafeURL("/admin/sections/" + formatUint(view.SectionID) + "/schedule") }>ساعات کاری</a>
					<a class="ui-btn ui-btn-ghost text-xs" href={ templ.SafeURL("/admin/sections/" + formatUint(view.SectionID) + "/doctors") }>پزشکان</a>
					<a class="ui-btn ui-btn-ghost text-xs" href={ templ.SafeURL("/admin/sections/" + formatUint(view.SectionID) + "/messages") }>پیام‌ها</a>
				</div>
			</div>

			if view.Message != "" {
				<p class="ui-panel mb-4 text-sm text-brand">{ view.Message }</p>
			}

			<section class="ui-panel mb-6">
				if view.EditID > 0 {
					<h2 class="mb-3 text-lg font-bold text-ink">ویرایش تجهیزات</h2>
					<form class="space-y-5" method="post" action={ templ.SafeURL("/admin/sections/" + formatUint(view.SectionID) + "/equipment/" + formatUint(view.EditID) + "/update") } enctype="multipart/form-data">
						@equipmentFormFields(view.EditQuoteTitle, view.EditQuoteText, view.EditBadge, view.EditImageURL, view.EditTitle, view.EditSubtitle, view.EditDescription, view.EditTags, view.EditButtonText, view.EditButtonURL, view.EditSortOrder, view.EditIsActive)
						<div class="flex items-center gap-2 pt-2">
							<button class="ui-btn ui-btn-primary" type="submit">ذخیره تغییرات</button>
							<a class="ui-btn ui-btn-ghost" href={ templ.SafeURL("/admin/sections/" + formatUint(view.SectionID) + "/equipment") }>انصراف</a>
						</div>
					</form>
				} else {
					<h2 class="mb-3 text-lg font-bold text-ink">افزودن معرفی تجهیزات جدید</h2>
					<form class="space-y-5" method="post" action={ templ.SafeURL("/admin/sections/" + formatUint(view.SectionID) + "/equipment") } enctype="multipart/form-data">
						@equipmentFormFields("", "", "فناوری روز دنیا", "", "", "", "", "وضوح بالا, استاندارد بین‌المللی", "رزرو نوبت", "/doctors", 0, true)
						<div class="pt-2">
							<button class="ui-btn ui-btn-primary" type="submit">افزودن آیتم</button>
						</div>
					</form>
				}
			</section>

			<section class="ui-panel">
				<h2 class="mb-3 text-lg font-bold text-ink">لیست تجهیزات تعریف‌شده ({ strconv.Itoa(len(view.Items)) })</h2>
				<div class="ui-table-wrap overflow-x-auto">
					<table class="ui-table min-w-[700px] text-sm">
						<thead>
							<tr class="border-b border-gray-200 bg-surface-soft text-right">
								<th class="p-3">ردیف</th>
								<th class="p-3">تصویر</th>
								<th class="p-3">عنوان تجهیزات</th>
								<th class="p-3">عنوان باکس نقل‌قول</th>
								<th class="p-3">برچسب‌ها</th>
								<th class="p-3">ترتیب</th>
								<th class="p-3">وضعیت</th>
								<th class="p-3">اقدام</th>
							</tr>
						</thead>
						<tbody>
							if len(view.Items) == 0 {
								<tr>
									<td class="p-4 text-center text-ink-muted" colspan="8">هیچ آیتم معرفی تجهیزاتی تعریف نشده است.</td>
								</tr>
							}
							for index, item := range view.Items {
								<tr class="border-b border-gray-100 hover:bg-surface-soft/50">
									<td class="p-3">{ strconv.Itoa(index + 1) }</td>
									<td class="p-3">
										if item.ImageURL != "" {
											<img class="h-10 w-14 rounded object-cover border" src={ item.ImageURL } alt=""/>
										} else {
											<span class="text-xs text-ink-muted">—</span>
										}
									</td>
									<td class="p-3 font-semibold text-ink">{ item.Title }</td>
									<td class="p-3 text-xs text-ink-muted">{ item.QuoteTitle }</td>
									<td class="p-3 text-xs">{ item.Tags }</td>
									<td class="p-3">{ strconv.Itoa(item.SortOrder) }</td>
									<td class="p-3">
										if item.IsActive {
											<span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-800">فعال</span>
										} else {
											<span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-600">غیرفعال</span>
										}
									</td>
									<td class="p-3 whitespace-nowrap">
										<div class="flex items-center gap-2">
											<a class="rounded border border-gray-300 px-2.5 py-1 text-xs hover:bg-gray-50" href={ templ.SafeURL("/admin/sections/" + formatUint(view.SectionID) + "/equipment?edit=" + formatUint(item.ID)) }>ویرایش</a>
											<form class="inline" method="post" action={ templ.SafeURL("/admin/sections/" + formatUint(view.SectionID) + "/equipment/" + formatUint(item.ID) + "/delete") } onsubmit="return confirm('این آیتم حذف شود؟');">
												<button class="rounded border border-red-300 px-2.5 py-1 text-xs text-red-700 hover:bg-red-50" type="submit">حذف</button>
											</form>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		</div>
	}
}

// equipmentFormFields renders inputs for both Part 1 (Quote box) and Part 2 (Two-column layout).
templ equipmentFormFields(quoteTitle, quoteText, badge, imageURL, title, subtitle, description, tags, buttonText, buttonURL string, sortOrder int, isActive bool) {
	<div class="space-y-6">
		<!-- بخش اول: باکس متنی نقل‌قول -->
		<div class="rounded-xl border border-teal-200 bg-teal-50/30 p-4">
			<h3 class="text-sm font-bold text-teal-950 mb-3 flex items-center gap-2">
				<span class="flex h-6 w-6 items-center justify-center rounded-full bg-teal-600 text-xs font-bold text-white">۱</span>
				بخش اول: باکس متنی / نقل‌قول طولانی (نمایش در مرکز صفحه)
			</h3>
			<div class="space-y-3">
				<label class="block text-sm text-ink-muted">
					عنوان باکس نقل‌قول (اختیاری)
					<input class="ui-field mt-1 w-full" type="text" name="quote_title" value={ quoteTitle } maxlength="200" placeholder="مثال: پیامی به شما، عزیزان"/>
				</label>
				<label class="block text-sm text-ink-muted">
					متن نقل‌قول / مقدمه تجهیزات
					<textarea class="ui-field mt-1 w-full leading-relaxed" name="quote_text" rows="4" maxlength="1500" placeholder="متن کامل پیام یا نقل‌قول معرفی و تعهد کیفیت...">{ quoteText }</textarea>
				</label>
			</div>
		</div>

		<!-- بخش دوم: معرفی دستگاه / قالب دو ستونی -->
		<div class="rounded-xl border border-gray-200 bg-surface-soft/40 p-4">
			<h3 class="text-sm font-bold text-ink mb-3 flex items-center gap-2">
				<span class="flex h-6 w-6 items-center justify-center rounded-full bg-brand text-xs font-bold text-white">۲</span>
				بخش دوم: مشخصات و تصویر دستگاه (قالب دو ستونی)
			</h3>
			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
				<label class="block text-sm text-ink-muted">
					عنوان دستگاه / تجهیزات
					<input class="ui-field mt-1 w-full" type="text" name="title" value={ title } required maxlength="200" placeholder="مثال: دستگاه MRI ۳ تسلا"/>
				</label>
				<label class="block text-sm text-ink-muted">
					زیرعنوان یا عبارت برجسته
					<input class="ui-field mt-1 w-full" type="text" name="subtitle" value={ subtitle } maxlength="200" placeholder="مثال: دقت بی‌نظیر در تشخیص"/>
				</label>
				<label class="block text-sm text-ink-muted">
					نشان / برچسب گوشه تصویر
					<input class="ui-field mt-1 w-full" type="text" name="badge" value={ badge } maxlength="100" placeholder="مثال: فناوری روز دنیا"/>
				</label>
				<label class="block text-sm text-ink-muted">
					برچسب‌های کلیدی (با کاما یا خط جدا کنید)
					<input class="ui-field mt-1 w-full" type="text" name="tags" value={ tags } maxlength="500" placeholder="وضوح ۳ تسلا, نتیجه همان روز, هوش مصنوعی"/>
				</label>
			</div>

			<div class="mt-4">
				<label class="block text-sm text-ink-muted mb-1">
					توضیحات کامل دستگاه
				</label>
				<textarea class="ui-field w-full leading-relaxed" name="description" rows="5" required maxlength="2000" placeholder="توضیحات کامل درباره قابلیت‌ها، دقت، کاربردها و مزایای دستگاه برای بیمار...">{ description }</textarea>
			</div>

			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 mt-4">
				<label class="block text-sm text-ink-muted">
					متن دکمه اقدام (CTA)
					<input class="ui-field mt-1 w-full" type="text" name="button_text" value={ buttonText } maxlength="100" placeholder="مثال: رزرو نوبت تصویربرداری"/>
				</label>
				<label class="block text-sm text-ink-muted">
					لینک دکمه اقدام
					<input class="ui-field mt-1 w-full font-mono text-xs" dir="ltr" type="text" name="button_url" value={ buttonURL } maxlength="500" placeholder="/doctors"/>
				</label>
			</div>

			<div class="mt-4">
				<label class="block text-sm text-ink-muted mb-1">
					تصویر دستگاه (حداکثر ۵ مگابایت)
				</label>
				<input class="block w-full text-sm text-ink-muted file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-brand/10 file:text-brand hover:file:bg-brand/20" type="file" name="image" accept="image/*"/>
				if imageURL != "" {
					<div class="mt-3 flex items-center gap-4">
						<img class="h-20 w-32 rounded object-cover border" src={ imageURL } alt="پیش‌نمایش تصویر دستگاه"/>
						<label class="flex items-center gap-2 text-xs text-ink-muted cursor-pointer">
							<input type="checkbox" name="clear_image" value="1"/>
							حذف تصویر فعلی
						</label>
					</div>
				}
			</div>
		</div>

		<div class="flex flex-wrap items-center gap-6">
			<label class="block text-sm text-ink-muted">
				ترتیب نمایش
				<input class="ui-field mt-1 w-24" type="number" name="sort_order" value={ strconv.Itoa(sortOrder) } min="0" max="999"/>
			</label>
			<div class="flex items-center pt-5">
				<label class="flex items-center gap-2 text-sm font-medium text-ink cursor-pointer">
					if isActive {
						<input type="checkbox" name="is_active" value="1" checked class="h-4 w-4 rounded border-gray-300 text-brand focus:ring-brand"/>
					} else {
						<input type="checkbox" name="is_active" value="1" class="h-4 w-4 rounded border-gray-300 text-brand focus:ring-brand"/>
					}
					نمایش در سایت
				</label>
			</div>
		</div>
	</div>
}
