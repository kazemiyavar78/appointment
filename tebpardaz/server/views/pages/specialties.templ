package pages

// Specialties فهرست تخصص‌های دارای پزشک عمومی را رندر می‌کند.
templ Specialties(view SpecialtiesView) {
	<div class="ui-fade-in mx-auto max-w-6xl">
		<nav class="mb-4 text-sm text-ink-muted" aria-label="مسیر">
			<a class="ui-link" href="/">خانه</a>
			<span aria-hidden="true"> / </span>
			<span>تخصص‌های پزشکی</span>
		</nav>
		<section class="ui-section mb-5">
			<h1 class="ui-page-title">تخصص‌های پزشکی</h1>
			<p class="ui-page-desc">تخصص را انتخاب کنید، پزشکان همان رشته را ببینید و نوبت بگیرید.</p>
		</section>
		if len(view.Items) == 0 {
			<p class="py-10 text-center text-sm text-ink-muted">تخصصی با پزشک فعال برای نمایش وجود ندارد.</p>
		} else {
			<ul class="divide-y divide-surface-border overflow-hidden rounded-2xl border border-surface-border bg-white">
				for _, sp := range view.Items {
					<li>
						<a class="flex items-center justify-between gap-3 px-4 py-3.5 transition hover:bg-surface-soft" href={ templ.SafeURL(sp.URL) }>
							<span class="min-w-0 flex-1 text-right">
								<span class="block text-sm font-bold text-ink">{ sp.Name }</span>
								<span class="mt-1 block text-sm text-ink-muted">{ intToString(sp.DoctorCount) } پزشک</span>
							</span>
						</a>
					</li>
				}
			</ul>
		}
	</div>
}
