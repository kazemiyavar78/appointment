package pages

// ClinicList صفحه فهرست مراکز (جایگاه فیلتر شهر و کارت‌ها) را رندر می‌کند.
templ ClinicList() {
	<div class="ui-fade-in mx-auto max-w-5xl">
		<section class="ui-section">
			<h1 class="ui-page-title">لیست مراکز</h1>
			<p class="ui-page-desc">مرکز درمانی مورد نظر را انتخاب کنید.</p>
		</section>
		<ul class="space-y-3">
			<li class="ui-panel text-sm text-ink-muted">
				هنوز مرکزی برای نمایش ثبت نشده است.
			</li>
		</ul>
	</div>
}
