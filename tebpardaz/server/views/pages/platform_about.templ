package pages

// PlatformAboutPage لندینگ «درباره ما» شرکت طب‌پرداز را در قالب پلتفرم رندر می‌کند.
templ PlatformAboutPage() {
	<link rel="stylesheet" href="/static/css/platform_about.css"/>
	<div class="tp-about">
		<nav class="tp-about-subnav wrap" aria-label="بخش‌های صفحه">
			<a href="#why">چرا طب‌‌پرداز</a>
			<a href="#journey">مسیر بیمار</a>
			<a href="#modules">ماژول‌ها</a>
			<a href="#team">تیم</a>
			<a href="#centers">مراکز فعال</a>
			<a href="/contact">تماس با ما</a>
		</nav>
		<section class="hero">
			<div class="wrap hero-grid">
				<div>
					<div class="eyebrow-line">۲۵+ سال در کنار مراکز درمانی کشور</div>
					<h1>مدیریت هوشمند و یکپارچه مراکز درمانی؛ <span>از پذیرش تا آزمایشگاه</span></h1>
					<p class="lead">طب‌پرداز، سیستم مدیریت کلینیک، مطب و درمانگاه، پرونده هر بیمار را از لحظه ورود تا پایان درمان دنبال می‌کند و کلینیک، دندان‌پزشکی، تصویربرداری، آزمایشگاه، حقوق و انبار مرکز شما را در یک سامانه واحد کنار هم می‌گذارد.</p>
					<div class="hero-actions">
						<a class="btn-primary" href="#cta">
							دریافت مشاوره رایگان
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
						</a>
						<a class="btn-secondary" href="#modules">دیدن همه ماژول‌ها</a>
					</div>
					<div class="hero-chans">
						<div class="hero-chan">
							<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 5a2 2 0 012-2h2.5a1 1 0 01.98.79l1 4.5a1 1 0 01-.27.95L7.5 10.9a12 12 0 006 6l1.66-1.7a1 1 0 01.96-.27l4.5 1a1 1 0 01.79.98V20a2 2 0 01-2 2h-1C9.6 22 2 14.4 2 5V5z" stroke="currentColor" stroke-width="1.6"></path></svg>
							پشتیبانی ۲۴/۷
						</div>
						<div class="hero-chan">
							<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 4h16v12H7l-3 3V4z" stroke="currentColor" stroke-width="1.6"></path></svg>
							ایتا، بله، تلگرام
						</div>
						<div class="hero-chan">
							<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"></circle><path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
							ثبت تیکت فوری
						</div>
					</div>
				</div>
				<div class="hero-illus">
					<div class="illus-frame">
						@platformAboutHeroIllustration()
					</div>
					<div class="illus-badge">
						<span class="num">۲۱۵+</span>
						<span class="lbl">کلینیک فعال با<br/>طب‌پرداز</span>
					</div>
				</div>
			</div>
		</section>
		<section class="trust" aria-label="آمار کلیدی">
			<div class="wrap trust-grid">
				<div class="trust-item"><div class="n">۲۵+</div><div class="l">سال تجربه</div></div>
				<div class="trust-item"><div class="n">۲۱۵+</div><div class="l">کلینیک فعال</div></div>
				<div class="trust-item"><div class="n">۱۰۰,۰۰۰+</div><div class="l">پرونده دیجیتال</div></div>
				<div class="trust-item"><div class="n">۲۴/۷</div><div class="l">پشتیبانی</div></div>
			</div>
		</section>
		<section class="sec" id="why">
			<div class="wrap">
				<div class="sec-head">
					<h2>چرا مراکز درمانی طب‌پرداز را انتخاب می‌کنند</h2>
					<p>به‌جای فهرست امکانات فنی، این چهار نتیجه‌ای‌ست که هر روز در کلینیک شما اتفاق می‌افتد.</p>
				</div>
			</div>
			<div class="wrap">
				<div class="why-grid">
					<div class="why-item reveal">
						<svg class="ic" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"></circle></svg>
						<h3>کاهش خطای انسانی</h3>
						<p>حذف خطاهای ثبت و محاسبات با پرونده الکترونیک سلامت (EHR) و استعلام آنی بیمه سلامت و تأمین اجتماعی.</p>
					</div>
					<div class="why-item reveal">
						<svg class="ic" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 7v5l3 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"></circle></svg>
						<h3>سرعت در خدمات</h3>
						<p>مدیریت بهینه صف، نوبت‌دهی اینترنتی و فراخوانی دیجیتال بیمار در سالن انتظار.</p>
					</div>
					<div class="why-item reveal">
						<svg class="ic" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19V9M12 19V5M19 19v-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
						<h3>گزارش‌دهی دقیق</h3>
						<p>داشبورد مالی و عملکردی برای هر بخش، هر پزشک و هر بازه زمانی دلخواه.</p>
					</div>
					<div class="why-item reveal">
						<svg class="ic" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l7 3v6c0 5-3.5 7.5-7 9-3.5-1.5-7-4-7-9V6l7-3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg>
						<h3>امنیت داده‌ها</h3>
						<p>حفاظت کامل از پرونده‌های پزشکی با سطوح دسترسی دقیق برای هر نقش کاری.</p>
					</div>
				</div>
			</div>
		</section>
		@platformAboutJourneySection()
		@platformAboutModulesSection()
		@platformAboutHistorySection()
		@platformAboutTeamSection()
		@platformAboutCentersSection()
		@platformAboutFinalCTA()
		<script>
			(function () {
				var els = document.querySelectorAll('.tp-about .reveal');
				if (!('IntersectionObserver' in window)) {
					els.forEach(function (el) { el.classList.add('in'); });
					return;
				}
				var io = new IntersectionObserver(function (entries) {
					entries.forEach(function (e) {
						if (e.isIntersecting) {
							e.target.classList.add('in');
							io.unobserve(e.target);
						}
					});
				}, { threshold: 0.15 });
				els.forEach(function (el) { io.observe(el); });
			})();
		</script>
	</div>
}

templ platformAboutHeroIllustration() {
	<svg viewBox="0 0 420 380" fill="none" aria-hidden="true">
		<rect x="0" y="0" width="420" height="380" rx="18" fill="#FBF8F2" opacity="0.35"></rect>
		<rect x="30" y="40" width="220" height="130" rx="14" fill="#2A4A3F"></rect>
		<rect x="50" y="60" width="90" height="10" rx="5" fill="#C97A3D"></rect>
		<rect x="50" y="82" width="150" height="8" rx="4" fill="#EBDFC7" opacity="0.6"></rect>
		<rect x="50" y="98" width="120" height="8" rx="4" fill="#EBDFC7" opacity="0.4"></rect>
		<circle cx="205" cy="145" r="18" fill="#C97A3D"></circle>
		<path d="M197 145l5 6 10-13" stroke="#2A4A3F" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
		<rect x="270" y="20" width="120" height="150" rx="14" fill="#FFFFFF"></rect>
		<circle cx="330" cy="70" r="26" fill="#EBDFC7"></circle>
		<path d="M330 62v16M322 70h16" stroke="#3E6C5C" stroke-width="3" stroke-linecap="round"></path>
		<rect x="290" y="112" width="80" height="8" rx="4" fill="#DCD2BA"></rect>
		<rect x="290" y="128" width="60" height="8" rx="4" fill="#DCD2BA"></rect>
		<rect x="30" y="200" width="360" height="150" rx="16" fill="#FFFFFF"></rect>
		<path d="M50 320l40-60 35 30 50-80 45 50 40-25 35 40 45-10" stroke="#3E6C5C" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
		<circle cx="90" cy="260" r="4" fill="#C97A3D"></circle>
		<circle cx="175" cy="210" r="4" fill="#C97A3D"></circle>
		<circle cx="260" cy="240" r="4" fill="#C97A3D"></circle>
		<circle cx="335" cy="255" r="4" fill="#C97A3D"></circle>
	</svg>
}

templ platformAboutJourneySection() {
	<section class="sec alt-bg" id="journey">
		<div class="wrap">
			<div class="sec-head">
				<h2>یک روز واقعی در کلینیک شما</h2>
				<p>از لحظه‌ای که بیمار وارد درمانگاه می‌شود تا پایان ویزیت و تسویه‌حساب، طب‌پرداز کنار شماست.</p>
			</div>
			<div class="journey">
				<div class="journey-line" aria-hidden="true"></div>
				<div class="journey-step">
					<div class="journey-dot">۱</div>
					<div class="journey-card">
						<span class="tag">پذیرش</span>
						<h3>ورود بیمار و پذیرش بدون تایپ</h3>
						<p>با گرفتن کد ملی، اعتبار بیمه و اطلاعات هویتی بیمار مستقیم از سایت بیمه استعلام می‌شود، پزشک انتخاب و نوبت ثبت می‌گردد؛ پرسنل مقیم بخش هم برای جلوگیری از خطای پذیرش کنترل می‌شود.</p>
					</div>
				</div>
				<div class="journey-step">
					<div class="journey-dot">۲</div>
					<div class="journey-card">
						<span class="tag">سالن انتظار</span>
						<h3>نوبت‌دهی و مانیتورینگ صف (CMS)</h3>
						<p>نرم‌افزار نوبت‌دهی اینترنتی پزشک، نوبت را روی نمایشگر سالن انتظار می‌نشاند، پیامک یادآوری ارسال می‌کند و پزشک با یک کلیک بیمار بعدی را فرا می‌خواند.</p>
					</div>
				</div>
				<div class="journey-step">
					<div class="journey-dot">۳</div>
					<div class="journey-card">
						<span class="tag">اتاق ویزیت</span>
						<h3>کارتابل جامع پزشک</h3>
						<p>پزشک در یک پنل به سوابق بیمار، تصاویر PACS، جواب آزمایش و بانک اطلاعات دارویی دسترسی دارد؛ با فشردن «ویزیت شد» هم پرونده قطعی می‌شود و هم محاسبه کارانه او دقیق‌تر انجام می‌شود.</p>
					</div>
				</div>
				<div class="journey-step">
					<div class="journey-dot">۴</div>
					<div class="journey-card">
						<span class="tag">آزمایشگاه و تصویربرداری</span>
						<h3>پاسخ‌دهی متصل به دیتاس</h3>
						<p>پذیرش آزمایش و تصویربرداری مستقیم به سامانه‌های وزارت بهداشت متصل است؛ جواب نهایی هم به‌صورت پیامک و PDF برای بیمار ارسال می‌شود.</p>
					</div>
				</div>
				<div class="journey-step">
					<div class="journey-dot">۵</div>
					<div class="journey-card">
						<span class="tag">صندوق و مالی</span>
						<h3>تسویه‌حساب و بستن صندوق</h3>
						<p>هر تراکنش، تخفیف و مغایرت به‌صورت لحظه‌ای ثبت می‌شود؛ در پایان روز صندوق با یک گزارش دقیق بسته و به حسابداری متصل می‌شود.</p>
					</div>
				</div>
				<div class="journey-step">
					<div class="journey-dot">۶</div>
					<div class="journey-card">
						<span class="tag">پایان ماه</span>
						<h3>حقوق و دستمزد با یک کلیک</h3>
						<p>سیستم بر پایه آیتم‌های محاسباتی و فرمول‌های از پیش تعریف‌شده، حقوق تمام پزشکان و پرسنل را در چند ثانیه محاسبه و فیش حقوقی صادر می‌کند.</p>
					</div>
				</div>
			</div>
		</div>
	</section>
}

templ platformAboutModulesSection() {
	<section class="sec" id="modules">
		<div class="wrap">
			<div class="sec-head">
				<h2>ماژول به ماژول با نرم‌افزار طب‌پرداز آشنا شوید</h2>
				<p>مجموعه‌ای از نرم‌افزار مدیریت کلینیک، دندان‌پزشکی، آزمایشگاه و تصویربرداری که هر بخش مرکز شما را با بقیه سیستم یکپارچه نگه می‌دارد.</p>
			</div>
			<div class="module reveal">
				<div class="module-visual" style="background:#EBDFC7;">
					<svg viewBox="0 0 300 240" fill="none" aria-hidden="true"><rect x="20" y="30" width="260" height="150" rx="14" fill="#FFFFFF"></rect><rect x="40" y="50" width="80" height="10" rx="5" fill="#3E6C5C"></rect><rect x="40" y="72" width="140" height="8" rx="4" fill="#DCD2BA"></rect><rect x="40" y="88" width="110" height="8" rx="4" fill="#DCD2BA"></rect><circle cx="230" cy="90" r="30" fill="#EBDFC7"></circle><path d="M218 90l8 8 16-18" stroke="#C97A3D" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path><rect x="40" y="120" width="220" height="1" fill="#DCD2BA"></rect><rect x="40" y="136" width="60" height="24" rx="6" fill="#2A4A3F"></rect><rect x="110" y="136" width="60" height="24" rx="6" fill="#DCD2BA"></rect><rect x="180" y="136" width="60" height="24" rx="6" fill="#DCD2BA"></rect></svg>
				</div>
				<div class="module-body">
					<div class="module-num">ماژول ۰۱</div>
					<h3>کلینیک و صندوق</h3>
					<p>ستون فقرات درمانگاه؛ از پذیرش عمومی و اورژانس تا صندوق، بیمه و گزارش‌های مدیریتی، همه در یک محیط.</p>
					<ul class="module-list">
						<li>پذیرش بدون تایپ با استعلام آنی اعتبار بیمه</li>
						<li>نوبت‌دهی اینترنتی و حضوری با یادآوری پیامکی</li>
						<li>جستجوی بیمار بر اساس نام، کد ملی، شماره قبض یا دفترچه</li>
						<li>بیش از ۲۵ نوع گزارش کارکرد، صندوق و مقایسه‌ای</li>
						<li>حیطه‌بندی دسترسی کاربران و تهیه نسخه پشتیبان</li>
					</ul>
				</div>
			</div>
			<div class="module reveal">
				<div class="module-visual" style="background:#DCE8E0;">
					<svg viewBox="0 0 300 240" fill="none" aria-hidden="true"><rect x="30" y="40" width="90" height="150" rx="10" fill="#2A4A3F"></rect><rect x="130" y="70" width="90" height="120" rx="10" fill="#3E6C5C"></rect><rect x="230" y="100" width="50" height="90" rx="10" fill="#C97A3D"></rect><rect x="45" y="55" width="60" height="8" rx="4" fill="#EBDFC7"></rect><rect x="45" y="70" width="40" height="8" rx="4" fill="#EBDFC7" opacity="0.6"></rect><rect x="145" y="85" width="60" height="8" rx="4" fill="#EBDFC7"></rect><path d="M45 160l15-20 15 12 15-25" stroke="#EBDFC7" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				</div>
				<div class="module-body">
					<div class="module-num">ماژول ۰۲</div>
					<h3>انبارداری و مدیریت موجودی</h3>
					<p>نظارت دقیق بر گردش کالای مرکز درمانی و جلوگیری از هدررفت منابع و اقلام پزشکی.</p>
					<ul class="module-list">
						<li>پشتیبانی از FIFO و LIFO برای مدیریت تاریخ انقضا</li>
						<li>تخمین خودکار مواد مصرفی و لیست خرید هوشمند</li>
						<li>کنترل کامل فاکتورهای ورود، خروج و سفارشات</li>
						<li>برچسب‌گذاری اقلام، واحدها و مراکز خرید و توزیع</li>
						<li>خروجی Word، Excel و PDF بر اساس کالا یا تأمین‌کننده</li>
					</ul>
				</div>
			</div>
			<div class="module reveal">
				<div class="module-visual" style="background:#F0E6D2;">
					<svg viewBox="0 0 300 240" fill="none" aria-hidden="true"><rect x="30" y="30" width="240" height="160" rx="14" fill="#FFFFFF"></rect><path d="M50 160l30-50 30 25 40-70 40 55 30-15 30 30" stroke="#C97A3D" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"></path><rect x="50" y="175" width="200" height="1" fill="#DCD2BA"></rect><circle cx="80" cy="110" r="4" fill="#2A4A3F"></circle><circle cx="140" cy="65" r="4" fill="#2A4A3F"></circle><circle cx="210" cy="120" r="4" fill="#2A4A3F"></circle></svg>
				</div>
				<div class="module-body">
					<div class="module-num">ماژول ۰۳</div>
					<h3>حسابداری تخصصی</h3>
					<p>نرم‌افزار حسابداری مراکز درمانی برای شفافیت مالی کامل؛ از دفاتر تا حقوق پزشکان.</p>
					<ul class="module-list">
						<li>دفاتر کل، معین و تفصیلی به‌صورت یکپارچه</li>
						<li>ثبت و مدیریت اسناد بانکی و چک‌ها</li>
						<li>ثبت خودکار درآمد صندوق روزانه و لینک با اسناد انبار</li>
						<li>بستن دوره‌های مالی ماهانه و سالانه</li>
						<li>سطح دسترسی دقیق برای هر کاربر مالی</li>
					</ul>
				</div>
			</div>
			<div class="module reveal">
				<div class="module-visual" style="background:#E4D9E8;">
					<svg viewBox="0 0 300 240" fill="none" aria-hidden="true"><rect x="40" y="30" width="220" height="150" rx="12" fill="#232A26"></rect><rect x="60" y="50" width="180" height="90" rx="8" fill="#4B5750"></rect><circle cx="150" cy="95" r="34" fill="none" stroke="#C97A3D" stroke-width="3"></circle><circle cx="150" cy="95" r="10" fill="#C97A3D"></circle><rect x="90" y="160" width="120" height="10" rx="5" fill="#EBDFC7"></rect></svg>
				</div>
				<div class="module-body">
					<div class="module-num">ماژول ۰۴</div>
					<h3>طب تصویری PACS / RIS</h3>
					<p>نرم‌افزار PACS RIS رادیولوژی؛ از پذیرش تا جواب نهایی در رادیولوژی، سونوگرافی و سی‌تی‌اسکن.</p>
					<ul class="module-list">
						<li>پذیرش آسان و تشخیص خودکار زیربخش خدمات</li>
						<li>نوبت‌دهی هوشمند برای کاهش زمان انتظار</li>
						<li>جواب‌دهی دستی یا خودکار با قالب‌های پیش‌فرض</li>
						<li>تعریف پروتکل‌های آمادگی پیش از تصویربرداری</li>
						<li>گزارش عملکرد تکنسین‌ها و رادیولوژیست‌ها</li>
					</ul>
				</div>
			</div>
			<div class="module reveal">
				<div class="module-visual" style="background:#D9E4E0;">
					<svg viewBox="0 0 300 240" fill="none" aria-hidden="true"><rect x="35" y="35" width="230" height="60" rx="10" fill="#FFFFFF"></rect><circle cx="60" cy="65" r="12" fill="#3E6C5C"></circle><rect x="82" y="55" width="150" height="8" rx="4" fill="#DCD2BA"></rect><rect x="82" y="70" width="100" height="8" rx="4" fill="#DCD2BA"></rect><rect x="35" y="110" width="230" height="60" rx="10" fill="#FFFFFF"></rect><circle cx="60" cy="140" r="12" fill="#C97A3D"></circle><rect x="82" y="130" width="150" height="8" rx="4" fill="#DCD2BA"></rect><rect x="82" y="145" width="120" height="8" rx="4" fill="#DCD2BA"></rect></svg>
				</div>
				<div class="module-body">
					<div class="module-num">ماژول ۰۵</div>
					<h3>آزمایشگاه</h3>
					<p>نرم‌افزار آزمایشگاه تشخیص طبی؛ پذیرش تا پاسخ نهایی با اتصال مستقیم به سامانه‌های رسمی وزارت بهداشت.</p>
					<ul class="module-list">
						<li>اتصال به دیتاس و ارسال خودکار اطلاعات</li>
						<li>تعریف مدل‌های آزمایش ساده و چند سر گروهه</li>
						<li>تعیین بازه نرمال جواب بر اساس سن، جنسیت یا توضیح</li>
						<li>تأیید نهایی از راه دور توسط مسئول فنی</li>
						<li>ارسال جواب بیمار به‌صورت پیامک با فرمت PDF</li>
					</ul>
				</div>
			</div>
			<div class="module reveal">
				<div class="module-visual" style="background:#EBDFC7;">
					<svg viewBox="0 0 300 240" fill="none" aria-hidden="true"><rect x="60" y="20" width="180" height="200" rx="16" fill="#FFFFFF"></rect><rect x="80" y="45" width="140" height="14" rx="7" fill="#2A4A3F"></rect><circle cx="150" cy="110" r="34" fill="#EBDFC7"></circle><path d="M150 96v28M136 110h28" stroke="#C97A3D" stroke-width="3" stroke-linecap="round"></path><rect x="90" y="165" width="120" height="8" rx="4" fill="#DCD2BA"></rect><rect x="105" y="180" width="90" height="8" rx="4" fill="#DCD2BA"></rect></svg>
				</div>
				<div class="module-body">
					<div class="module-num">ماژول ۰۶</div>
					<h3>سایت پزشک و سامانه مانیتورینگ (CMS)</h3>
					<p>پلی میان پذیرش، سالن انتظار و اتاق پزشک؛ برای کاهش شلوغی و اتصال هوشمند ویزیت به مالی.</p>
					<ul class="module-list">
						<li>نمایش نوبت روی مانیتورهای سالن انتظار و فراخوانی دیجیتال</li>
						<li>کارتابل بالینی با سوابق، PACS و بانک اطلاعات دارویی</li>
						<li>دکمه «ویزیت شد» برای قطعی‌سازی پرونده و جلوگیری از خطا</li>
						<li>محاسبه دقیق کارانه بر اساس بیماران واقعاً ویزیت‌شده</li>
						<li>روزشمار و برنامه کاری پزشک برای روزهای آینده</li>
					</ul>
				</div>
			</div>
			<div class="module reveal">
				<div class="module-visual" style="background:#DCE8E0;">
					<svg viewBox="0 0 300 240" fill="none" aria-hidden="true"><rect x="40" y="30" width="220" height="60" rx="10" fill="#3E6C5C"></rect><rect x="60" y="50" width="100" height="10" rx="5" fill="#FFFFFF"></rect><rect x="40" y="110" width="100" height="90" rx="10" fill="#FFFFFF"></rect><rect x="150" y="110" width="110" height="90" rx="10" fill="#FFFFFF"></rect><path d="M55 175l15-30 12 15 20-40" stroke="#C97A3D" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"></path><rect x="165" y="130" width="80" height="8" rx="4" fill="#DCD2BA"></rect><rect x="165" y="146" width="60" height="8" rx="4" fill="#DCD2BA"></rect><rect x="165" y="162" width="70" height="8" rx="4" fill="#DCD2BA"></rect></svg>
				</div>
				<div class="module-body">
					<div class="module-num">ماژول ۰۷</div>
					<h3>حقوق و دستمزد</h3>
					<p>نرم‌افزار محاسبه حقوق و دستمزد پزشکان؛ خداحافظی با اکسل و محاسبات دستی در پایان ماه.</p>
					<ul class="module-list">
						<li>آیتم‌های محاسباتی هوشمند برای استخراج خودکار داده پذیرش</li>
						<li>طراحی یک‌باره فرمول حقوقی و انتساب پرسنل به آن</li>
						<li>پشتیبانی از درصدهای متغیر بر اساس شیفت یا نوع خدمت</li>
						<li>محاسبه آنی کل پرسنل و پزشکان با یک کلیک</li>
						<li>صدور خودکار فیش حقوقی با ریز کارکرد و کسورات</li>
					</ul>
				</div>
			</div>
			<div class="module reveal">
				<div class="module-visual" style="background:#F0E6D2;">
					<svg viewBox="0 0 300 240" fill="none" aria-hidden="true"><ellipse cx="150" cy="120" rx="90" ry="60" fill="#FFFFFF"></ellipse><circle cx="110" cy="105" r="8" fill="#2A4A3F"></circle><circle cx="150" cy="95" r="8" fill="#2A4A3F"></circle><circle cx="190" cy="105" r="8" fill="#2A4A3F"></circle><circle cx="130" cy="135" r="8" fill="#C97A3D"></circle><circle cx="170" cy="135" r="8" fill="#C97A3D"></circle><path d="M90 165h120" stroke="#DCD2BA" stroke-width="3" stroke-linecap="round"></path></svg>
				</div>
				<div class="module-body">
					<div class="module-num">ماژول ۰۸</div>
					<h3>دندان‌پزشکی</h3>
					<p>نرم‌افزار دندانپزشکی برای پوشش کامل فرآیندهای مطب یا کلینیک.</p>
					<ul class="module-list">
						<li>پذیرش قابل شخصی‌سازی با ثبت شماره و جهت دندان</li>
						<li>ثبت تخفیف و فرانشیز لحظه‌ای، پرداخت یکجا یا قسطی</li>
						<li>نوبت‌دهی دوگانه؛ همگام‌سازی آنلاین و پنل داخلی</li>
						<li>هشدار سوابق بیماری زمینه‌ای برای هر بیمار</li>
						<li>گزارش‌های تفکیکی بر اساس پزشک، بخش و دوره زمانی</li>
					</ul>
				</div>
			</div>
		</div>
	</section>
}

templ platformAboutHistorySection() {
	<section class="sec alt-bg" id="history">
		<div class="wrap">
			<div class="sec-head">
				<h2>مسیری که تا امروز طی کرده‌ایم</h2>
				<p>طب‌پرداز شرق ایرانیان، حاصل بیش از دو دهه تجربه واقعی در کنار مراکز درمانی کشور است.</p>
			</div>
			<div class="history">
				<div class="history-item">
					<div class="yr">۲۵+ سال</div>
					<p>سابقه توسعه سیستم اطلاعات بیمارستانی (HIS) و نرم‌افزارهای تخصصی حوزه سلامت، از اولین نسخه‌های کلینیکی تا سامانه یکپارچه امروز.</p>
				</div>
				<div class="history-item">
					<div class="yr">۸ ماژول</div>
					<p>کلینیک و صندوق، دندان‌پزشکی، طب تصویری، آزمایشگاه، انبارداری، حسابداری، حقوق و سایت پزشک.</p>
				</div>
				<div class="history-item">
					<div class="yr">۲۱۵+ مرکز</div>
					<p>کلینیک، مطب و آزمایشگاه فعال که هم‌اکنون با سامانه طب‌پرداز کار روزانه خود را مدیریت می‌کنند.</p>
				</div>
				<div class="history-item">
					<div class="yr">۱۰۰,۰۰۰+</div>
					<p>پرونده دیجیتال بیمار، ثبت‌شده و در دسترس، با امنیت و سطح دسترسی مشخص برای هر کاربر.</p>
				</div>
			</div>
		</div>
	</section>
}

templ platformAboutTeamSection() {
	<section class="sec" id="team">
		<div class="wrap">
			<div class="sec-head">
				<h2>تیمی که پشت هر خط از این نرم‌افزار ایستاده</h2>
				<p>از اولین مشاوره تا روز پشتیبانی؛ یک تیم کامل کنار مرکز درمانی شما می‌ماند.</p>
			</div>
			<div class="team-grid">
				<div class="team-card">
					<svg class="team-ic" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 12l6 4 12-10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
					<h4>فروش و مشاوره</h4>
					<p>شناخت نیاز واقعی مرکز شما و پیشنهاد ماژول‌های مناسب پیش از هر قراردادی.</p>
				</div>
				<div class="team-card">
					<svg class="team-ic" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 20l4-1 10-10-3-3L5 16l-1 4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg>
					<h4>طراحی و تجربه کاربری</h4>
					<p>طراحی صفحات و فرم‌ها بر اساس جریان واقعی کار پذیرش، پزشک و صندوق.</p>
				</div>
				<div class="team-card">
					<svg class="team-ic" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 9l-4 3 4 3M16 9l4 3-4 3M13 6l-2 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
					<h4>برنامه‌نویسی</h4>
					<p>توسعه و به‌روزرسانی مداوم ماژول‌ها، هماهنگ با استانداردهای جدید وزارت بهداشت.</p>
				</div>
				<div class="team-card">
					<svg class="team-ic" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"></circle><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2 2M16.4 16.4l2 2M18.4 5.6l-2 2M7.6 16.4l-2 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
					<h4>شبکه و زیرساخت</h4>
					<p>راه‌اندازی و اتصال پایدار سرور، دستگاه‌های آزمایشگاهی و پرینترهای مرکز شما.</p>
				</div>
				<div class="team-card">
					<svg class="team-ic" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3a9 9 0 00-9 9v4a2 2 0 002 2h1v-7H4a8 8 0 0116 0h-2v7h1a2 2 0 002-2v-4a9 9 0 00-9-9z" stroke="currentColor" stroke-width="1.6"></path></svg>
					<h4>پشتیبانی ۲۴/۷</h4>
					<p>پاسخ‌گویی تیکتی و تلفنی، حتی خارج از ساعات اداری، برای مراکز درمانی که هرگز تعطیل نمی‌شوند.</p>
				</div>
			</div>
		</div>
	</section>
}

templ platformAboutCentersSection() {
	<section class="sec-tight" id="centers">
		<div class="wrap">
			<div class="centers">
				<svg class="centers-decor" viewBox="0 0 200 200" fill="none" aria-hidden="true"><circle cx="100" cy="100" r="90" stroke="#FFFFFF" stroke-width="2"></circle><circle cx="100" cy="100" r="60" stroke="#FFFFFF" stroke-width="2"></circle></svg>
				<h2>همکاران شما هم‌اکنون از طب‌پرداز استفاده می‌کنند</h2>
				<p>بیش از ۲۱۵ مرکز درمانی در ایران، از مطب‌های کوچک تا مجموعه‌های چندتخصصی، روزانه با بهترین نرم‌افزار مدیریت کلینیک ایران کار می‌کنند.</p>
				<div class="centers-stats">
					<div><div class="n">۲۱۵+</div><div class="l">کلینیک و مطب فعال</div></div>
					<div><div class="n">۸</div><div class="l">ماژول تخصصی</div></div>
					<div><div class="n">۲۵+</div><div class="l">سال حضور مستمر</div></div>
				</div>
			</div>
		</div>
	</section>
}

templ platformAboutFinalCTA() {
