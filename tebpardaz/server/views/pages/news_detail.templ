package pages

import (
	"time"

	"tebpardaz/server/views/components"
)

// NewsDetailView دادهٔ صفحه جزئیات خبر عمومی را نگه می‌دارد.
type NewsDetailView struct {
	TitleHTML       string
	BodyHTML        string
	CoverURL        string
	PublishedAt     time.Time
	ClinicName      string
	ShowClinicBadge bool
	BackURL         string
}

// newsDetailDate تاریخ انتشار جزئیات خبر را قالب‌بندی می‌کند.
// ورودی: زمان انتشار. خروجی: رشته تاریخ-ساعت یا خالی.
func newsDetailDate(t time.Time) string {
	if t.IsZero() {
		return ""
	}
	return t.Format("2006/01/02 15:04")
}

// NewsDetail یک مقاله خبر با بدنه HTML غنی را رندر می‌کند.
templ NewsDetail(view NewsDetailView) {
	<article class="ui-fade-in mx-auto max-w-3xl">
		<a class="ui-link mb-5 inline-flex min-h-[44px] items-center text-sm font-bold" href={ templ.SafeURL(view.BackURL) }>بازگشت به اخبار</a>
		if view.ShowClinicBadge && view.ClinicName != "" {
			<span class="ui-chip mb-3">{ view.ClinicName }</span>
		}
		<h1 class="ui-page-title mb-2">
			@templ.Raw(view.TitleHTML)
		</h1>
		if d := newsDetailDate(view.PublishedAt); d != "" {
			<p class="mb-5 text-sm text-ink-muted">{ d }</p>
		}
		if view.CoverURL != "" {
			<img class="mb-6 max-h-[28rem] w-full rounded-xl object-cover" src={ view.CoverURL } alt="" loading="lazy" decoding="async"/>
		}
		<div class="news-rich-body prose max-w-none text-ink">
			@templ.Raw(view.BodyHTML)
		</div>
	</article>
}

// NewsListView دادهٔ فهرست اخبار عمومی را نگه می‌دارد.
type NewsListView struct {
	Items           []components.NewsCardView
	ShowClinicBadge bool
	EmptyMessage    string
}

// NewsList همه کارت‌های خبر منتشرشده tenant را رندر می‌کند.
templ NewsList(view NewsListView) {
	<div class="ui-fade-in mx-auto max-w-4xl">
		<section class="ui-section">
			<h1 class="ui-page-title">اخبار</h1>
			<p class="ui-page-desc">اطلاعیه‌ها و توضیح تجهیزات مراکز.</p>
		</section>
		if len(view.Items) == 0 {
			<p class="text-ink-muted">{ view.EmptyMessage }</p>
		} else {
			<div class="news-grid">
				for _, item := range view.Items {
					@components.NewsCard(item)
				}
			</div>
		}
	</div>
}
