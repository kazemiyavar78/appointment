package pages

// WaitingQueueClinicOption گزینه انتخاب مرکز در لایه ارگان/پلتفرم است.
type WaitingQueueClinicOption struct {
	ID   uint
	Name string
}

// WaitingQueueFormView دادهٔ فرم و نمایش وضعیت صف انتظار را نگه می‌دارد.
type WaitingQueueFormView struct {
	ShowClinicSelect bool
	Clinics          []WaitingQueueClinicOption
	SelectedClinicID uint
	NationalID       string
	AdmissionNo      string
	CSRFToken        string
	FormAction       string
	ErrorMessage     string
	InfoMessage      string
	// برندینگ مرکز برای هدر صفحه
	ClinicName    string
	ClinicLogoURL string
	// پس از تأیید موفق، پنل زنده نمایش داده می‌شود
	ShowLivePanel bool
	Status        WaitingQueueStatusView
	WSPath        string
	PushPath      string
	VAPIDPublicKey string
	UpdatedAtUnix int64
}

// WaitingQueueStatusView وضعیت بیمار در صف برای نمایش ساده است.
type WaitingQueueStatusView struct {
	PatientName  string
	DoctorName   string
	VisitTime    string
	AheadCount   int
	TotalInQueue int
}

// WaitingQueueForm صفحه «وضعیت نوبت شما» را رندر می‌کند.
templ WaitingQueueForm(view WaitingQueueFormView) {
	<link rel="stylesheet" href="/static/css/waiting_queue.css"/>
	<div class="ui-fade-in mx-auto max-w-lg">
		if !view.ShowLivePanel {
			<section class="ui-hero text-center">
				if view.ClinicLogoURL != "" {
					<div class="mb-4 flex justify-center">
						<img
							src={ view.ClinicLogoURL }
							alt={ view.ClinicName }
							class="h-20 w-20 rounded-2xl border-2 border-brand/20 bg-white object-contain p-1.5 shadow-sm"
							width="80"
							height="80"
							loading="eager"
							onerror="this.style.display='none'"
						/>
					</div>
				}
				if view.ClinicName != "" {
					<p class="ui-hero-brand">{ view.ClinicName }</p>
				}
				<h1 class="ui-hero-title">وضعیت نوبت شما</h1>
				<p class="ui-hero-text mx-auto">
					شماره پذیرش را وارد کنید. اگر روی قبض کد ملی دارید، آن را هم بنویسید تا فقط نوبت خودتان را ببینید.
				</p>
			</section>
		} else if view.ClinicLogoURL != "" {
			<div class="mb-4 flex justify-center">
				<img
					src={ view.ClinicLogoURL }
					alt={ view.ClinicName }
					class="h-16 w-16 rounded-2xl border-2 border-brand/20 bg-white object-contain p-1.5 shadow-sm"
					width="64"
					height="64"
					loading="eager"
					onerror="this.style.display='none'"
				/>
			</div>
		}

		if view.ErrorMessage != "" {
			<div class="mb-4 rounded-xl border-2 border-red-300 bg-red-50 px-4 py-3 text-lg text-red-800" role="alert">
				{ view.ErrorMessage }
			</div>
		}
		if view.InfoMessage != "" {
			<div class="mb-4 rounded-xl border-2 border-amber-300 bg-amber-50 px-4 py-3 text-lg text-amber-900" role="status">
				{ view.InfoMessage }
			</div>
		}

		if !view.ShowLivePanel {
			<form
				class="ui-panel space-y-5"
				method="post"
				action={ templ.SafeURL(view.FormAction) }
				autocomplete="off"
			>
				<input type="hidden" name="csrf_token" value={ view.CSRFToken }/>

				if view.ShowClinicSelect {
					<div>
						<label class="ui-label text-lg" for="clinic_id">مرکز درمانی</label>
						<select id="clinic_id" name="clinic_id" required class="ui-field text-lg">
							<option value="">انتخاب مرکز…</option>
							for _, clinic := range view.Clinics {
								if view.SelectedClinicID == clinic.ID {
									<option value={ uintToString(clinic.ID) } selected>{ clinic.Name }</option>
								} else {
									<option value={ uintToString(clinic.ID) }>{ clinic.Name }</option>
								}
							}
						</select>
					</div>
				}

				<div>
					<label class="ui-label text-lg" for="admission_no">شماره پذیرش</label>
					<input
						id="admission_no"
						name="admission_no"
						type="text"
						required
						inputmode="numeric"
						placeholder="عدد روی قبض پذیرش"
						value={ view.AdmissionNo }
						class="ui-field text-xl"
					/>
				</div>

				<div>
					<label class="ui-label text-lg" for="national_id">کد ملی (اگر دارید)</label>
					<input
						id="national_id"
						name="national_id"
						type="text"
						inputmode="numeric"
						pattern="[0-9۰-۹]{10}"
						maxlength="10"
						placeholder="اگر روی قبض کد ملی نیست، خالی بگذارید"
						value={ view.NationalID }
						class="ui-field text-xl tracking-widest"
					/>
					<p class="mt-2 text-sm text-ink-muted">برای امنیت، اگر پذیرش شما کد ملی دارد باید همینجا هم وارد شود.</p>
				</div>

				<button type="submit" class="ui-btn ui-btn-primary ui-btn-block text-xl">
					نمایش وضعیت نوبت
				</button>
			</form>
		}

		if view.ShowLivePanel {
			<div
				id="waiting-queue-live"
				class={ waitingQueueLiveClass(view.Status.AheadCount) }
				data-ws-path={ view.WSPath }
				data-push-path={ view.PushPath }
				data-vapid-key={ view.VAPIDPublicKey }
				data-csrf-token={ view.CSRFToken }
				data-ahead-count={ intToString(view.Status.AheadCount) }
				data-updated-at={ int64ToString(view.UpdatedAtUnix) }
			>
				if view.ClinicName != "" {
					<p class="wq-clinic">{ view.ClinicName }</p>
				}
				<h1 id="wq-patient-name" class="wq-patient">{ view.Status.PatientName }</h1>

				<div class="wq-ring-wrap">
					<svg viewBox="0 0 260 260" aria-hidden="true">
						<circle class="wq-ring-bg" cx="130" cy="130" r="112"></circle>
						<circle
							id="wq-ring-fg"
							class="wq-ring-fg"
							cx="130"
							cy="130"
							r="112"
							stroke-dasharray="703.7"
							stroke-dashoffset={ ringDashOffset(view.Status.AheadCount) }
						></circle>
					</svg>
					<div class="wq-ring-center">
						<p id="wq-ahead-count" class="wq-ring-number" aria-live="polite">{ faQueueNumber(view.Status.AheadCount) }</p>
						<p id="wq-ring-label" class="wq-ring-label">{ ringCaption(view.Status.AheadCount) }</p>
					</div>
				</div>

				<p id="wq-status-banner" class="wq-banner" role="status" aria-live="polite">{ waitingQueueBanner(view.Status.AheadCount) }</p>

				<div class="wq-meta">
					<div>
						<span>پزشک</span>
						<b id="wq-doctor-name">{ view.Status.DoctorName }</b>
					</div>
					<div class="wq-meta-divider"></div>
					<div>
						<span>ساعت نوبت</span>
						<b id="wq-visit-time">{ view.Status.VisitTime }</b>
					</div>
					<div class="wq-meta-divider"></div>
					<div>
						<span>شماره پذیرش</span>
						<b id="wq-admission">{ view.AdmissionNo }</b>
					</div>
				</div>

				<div class="wq-conn">
					<span id="wq-conn-dot" class="wq-dot wq-dot-live"></span>
					<span id="wq-conn-text">بروزرسانی زنده — همین الان</span>
				</div>

				<button type="button" id="wq-confirm" class="wq-confirm">نوبت شماست — تأیید می‌کنم که در راهم</button>

				<div class="wq-actions">
					<button type="button" id="wq-sound-toggle" class="wq-chip" data-on="false">فعال‌سازی صدا و لرزش هشدار</button>
					<button type="button" id="wq-push-toggle" class="wq-chip">فعال‌سازی اعلان پس‌زمینه</button>
				</div>
				<p id="wq-ios-guide" class="wq-ios-guide" hidden>
					برای دریافت اعلان حتی با گوشی قفل، لطفاً روی دکمه اشتراک‌گذاری Safari بزنید و گزینه Add to Home Screen را انتخاب کنید، سپس از همان آیکون روی صفحه اصلی وارد شوید.
				</p>
				<p id="wq-push-msg" class="wq-push-msg" role="status"></p>
			</div>
			<script src="/static/js/waiting_queue.js" defer></script>
		} else {
			<script src="/static/js/waiting_queue.js" defer></script>
		}
	</div>
}
