package pages

import "tebpardaz/server/views/components"

// SectionsListView داده‌های صفحه فهرست بخش‌های درمانی را نگه می‌دارد.
type SectionsListView struct {
	Title            string
	Subtitle         string
	Sections         []components.SectionCardView
	ShowClinicFilter bool
}

// SectionsList صفحه فهرست کارت‌های بخش‌های درمانی را با طراحی بنر رندر می‌کند.
// ورودی: view حاوی لیست کارت‌های بخش و تنظیمات نمایش. خروجی: کامپوننت templ.
templ SectionsList(view SectionsListView) {
	<div class="ui-fade-in mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8" dir="rtl">
		<!-- سرلوحه صفحه بخش‌ها -->
		<div class="mb-8 text-center sm:text-right">
			<div class="mb-2 inline-flex items-center gap-2 rounded-full bg-brand-soft px-3.5 py-1 text-xs font-semibold text-brand">
				<span class="h-2 w-2 rounded-full bg-brand"></span>
				<span>بخش‌ها و دپارتمان‌های درمانی</span>
			</div>
			<h1 class="text-2xl sm:text-3xl font-extrabold text-ink">
				if view.Title != "" {
					{ view.Title }
				} else {
					بخش‌های تخصصی و پاراکلینیکی
				}
			</h1>
			if view.Subtitle != "" {
				<p class="mt-2 text-sm sm:text-base text-ink-muted max-w-2xl">
					{ view.Subtitle }
				</p>
			}
		</div>

		<!-- گرید کارت‌های بخش -->
		if len(view.Sections) > 0 {
			<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
				for _, sec := range view.Sections {
					@components.SectionCard(sec)
				}
			</div>
		} else {
			<div class="rounded-2xl border border-dashed border-surface-border bg-surface-soft/50 p-12 text-center">
				<div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-surface-border/40 text-2xl text-ink-muted">
					🏥
				</div>
				<h3 class="mt-4 text-base font-bold text-ink">هیچ بخشی تعریف نشده است</h3>
				<p class="mt-1 text-sm text-ink-muted">در حال حاضر بخش فعالی برای نمایش در این بخش ثبت نشده است.</p>
			</div>
		}
	</div>
}
