package pages

// TestResultClinicOption گزینه انتخاب کلینیک در لایه ارگان/پلتفرم است.
type TestResultClinicOption struct {
	ID   uint
	Name string
}

// TestResultFormView دادهٔ فرم جستجوی جواب آزمایش عمومی را نگه می‌دارد.
type TestResultFormView struct {
	ShowClinicSelect bool
	Clinics          []TestResultClinicOption
	SelectedClinicID uint
	AdmissionNo      string
	Password         string
	CSRFToken        string
	FormAction       string
	ErrorMessage     string
	InfoMessage      string
	DownloadURL      string
}

// TestResultForm فرم پذیرش و لینک اختیاری دانلود PDF را رندر می‌کند.
templ TestResultForm(view TestResultFormView) {
	<div class="ui-fade-in mx-auto max-w-xl">
		<section class="ui-hero">
			<h1 class="ui-hero-title">جواب آزمایش</h1>
			<p class="ui-hero-text">
				شماره و رمز پذیرش را وارد کنید تا در صورت آماده بودن، فایل PDF را دریافت کنید.
			</p>
		</section>

		if view.ErrorMessage != "" {
			<p class="mb-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700" role="alert">{ view.ErrorMessage }</p>
		}
		if view.InfoMessage != "" {
			<p class="mb-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800" role="status">{ view.InfoMessage }</p>
		}

		<form
			class="ui-panel space-y-4"
			method="post"
			action={ templ.SafeURL(view.FormAction) }
			autocomplete="off"
		>
			<input type="hidden" name="csrf_token" value={ view.CSRFToken }/>

			if view.ShowClinicSelect {
				<div>
					<label class="ui-label" for="clinic_id">کلینیک</label>
					<select id="clinic_id" name="clinic_id" required class="ui-field">
						<option value="">انتخاب کلینیک…</option>
						for _, clinic := range view.Clinics {
							if view.SelectedClinicID == clinic.ID {
								<option value={ uintToString(clinic.ID) } selected>{ clinic.Name }</option>
							} else {
								<option value={ uintToString(clinic.ID) }>{ clinic.Name }</option>
							}
						}
					</select>
				</div>
			}

			<div>
				<label class="ui-label" for="admission_no">شماره پذیرش</label>
				<input
					id="admission_no"
					name="admission_no"
					type="text"
					required
					inputmode="numeric"
					value={ view.AdmissionNo }
					class="ui-field"
				/>
			</div>

			<div>
				<label class="ui-label" for="password">رمز پذیرش</label>
				<input
					id="password"
					name="password"
					type="text"
					required
					value={ view.Password }
					class="ui-field"
				/>
			</div>

			<button type="submit" class="ui-btn ui-btn-primary">
				جستجوی جواب آزمایش
			</button>
		</form>

		if view.DownloadURL != "" {
			<div class="mt-4 rounded-xl border border-green-200 bg-green-50 px-4 py-4 text-sm">
				<p class="mb-3 text-green-800">جواب آزمایش آماده است.</p>
				<a
					class="ui-btn ui-btn-primary"
					href={ templ.SafeURL(view.DownloadURL) }
					download
					target="_blank"
					rel="noopener"
				>
					دانلود فایل PDF
				</a>
			</div>
		}
	</div>
}
