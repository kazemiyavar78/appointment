package pages

import (
	"tebpardaz/server/views/components"
)

// DoctorListFilterOption گزینه فیلتر تخصص یا مرکز است.
type DoctorListFilterOption struct {
	ID          uint
	Name        string
	Slug        string
	Description string
}

// DoctorListView دادهٔ صفحه فهرست عمومی پزشکان را نگه می‌دارد.
type DoctorListView struct {
	Doctors          []components.DoctorCardView
	Specialties      []DoctorListFilterOption
	Clinics          []DoctorListFilterOption
	ShowClinicFilter bool
	Query            string
	Date             string
	SpecialtyID      uint
	ClinicID         uint
	ClinicSlug       string
	FormAction       string
	EmptyMessage     string
	Page             int
	TotalPages       int
	TotalCount       int
	PageSize         int
}

// DoctorList فهرست پزشکان با فیلتر موبایل/دسکتاپ جدا را رندر می‌کند.
templ DoctorList(view DoctorListView) {
	<link rel="stylesheet" href="/static/css/specialty_cards.css"/>
	<div class="ui-fade-in mx-auto max-w-6xl">
		<section class="ui-section mb-5">
			<h1 class="ui-page-title">پزشکان</h1>
			<p class="ui-page-desc">پزشک را پیدا کنید و نوبت بگیرید.</p>
		</section>

		<div class="doctor-list-layout">
			<aside class="doctor-list-filters">
				<details class="doctor-list-filters-mobile doctor-list-filters-panel ui-panel">
					<summary class="flex min-h-[44px] cursor-pointer items-center justify-between gap-3 text-base font-bold text-ink">
						<span>جستجو و فیلتر</span>
						<span class="doctor-list-filters-toggle rounded-md bg-surface-soft px-2.5 py-1 text-sm font-normal text-ink-muted">باز کردن</span>
					</summary>
					@doctorListFilterForm(view, "m")
				</details>
				<div class="doctor-list-filters-desktop ui-panel">
					<p class="mb-3 text-base font-bold text-ink">جستجو و فیلتر</p>
					@doctorListFilterForm(view, "d")
				</div>
			</aside>

			<section class="doctor-list-results">
				<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
					<p class="text-base text-ink-muted">
						if view.TotalCount == 0 {
							پزشکی پیدا نشد
						} else {
							<span class="font-bold text-ink tabular-nums">{ intToString(view.TotalCount) }</span>
							<span>پزشک</span>
							if view.TotalPages > 1 {
								<span class="text-ink-faint">· صفحه { intToString(view.Page) } از { intToString(view.TotalPages) }</span>
							}
						}
					</p>
					if doctorListHasFilters(view) {
						<div class="flex max-w-full flex-wrap gap-2">
							if view.Query != "" {
								<a class="ui-chip" href={ templ.SafeURL(doctorListClearURL(view, "q")) } title="حذف نام">نام: { view.Query } ×</a>
							}
							if view.Date != "" {
								<a class="ui-chip tabular-nums" href={ templ.SafeURL(doctorListClearURL(view, "date")) } title="حذف تاریخ" dir="ltr">{ view.Date } ×</a>
							}
							if name := doctorListSpecialtyName(view); name != "" {
								<a class="ui-chip" href={ templ.SafeURL(doctorListClearURL(view, "specialty_id")) } title="حذف تخصص">{ name } ×</a>
							}
							if name := doctorListClinicName(view); name != "" {
								<a class="ui-chip" href={ templ.SafeURL(doctorListClearURL(view, "clinic")) } title="حذف مرکز">{ name } ×</a>
							}
						</div>
					}
				</div>

				if len(view.Doctors) == 0 {
					<div class="rounded-xl border border-dashed border-surface-border bg-white px-5 py-10 text-center">
						<p class="text-base text-ink-muted">{ view.EmptyMessage }</p>
						if doctorListHasFilters(view) {
							<a class="ui-link mt-4 inline-block text-base font-bold" href={ templ.SafeURL(view.FormAction) }>دیدن همه پزشکان</a>
						}
					</div>
				} else {
					@components.DoctorCardAssets()
					<div class="grid items-stretch gap-4 sm:grid-cols-2 xl:grid-cols-3">
						for _, item := range view.Doctors {
							@components.DoctorCard(item)
						}
					</div>
					if view.TotalPages > 1 {
						<nav class="doctor-list-pager mt-8 flex flex-wrap items-center justify-center gap-2" aria-label="صفحه‌بندی">
							if view.Page > 1 {
								<a href={ templ.SafeURL(doctorListPageURL(view, view.Page-1)) }>قبلی</a>
							}
							for _, p := range doctorListPaginationPages(view.Page, view.TotalPages) {
								if p == 0 {
									<span class="text-ink-faint">…</span>
								} else if p == view.Page {
									<span class="is-current tabular-nums" aria-current="page">{ intToString(p) }</span>
								} else {
									<a class="tabular-nums" href={ templ.SafeURL(doctorListPageURL(view, p)) }>{ intToString(p) }</a>
								}
							}
							if view.Page < view.TotalPages {
								<a href={ templ.SafeURL(doctorListPageURL(view, view.Page+1)) }>بعدی</a>
							}
						</nav>
					}
				}
			</section>
		</div>
		@components.PersianDatepickerAssets()
		<script>
			(function () {
				var panel = document.querySelector(".doctor-list-filters-panel");
				if (!panel) return;
				var toggle = panel.querySelector(".doctor-list-filters-toggle");
				if (!toggle) return;
				function sync() { toggle.textContent = panel.open ? "بستن" : "باز کردن"; }
				panel.addEventListener("toggle", sync);
				sync();
			})();
		</script>
	</div>
}

// doctorListFilterForm فیلدهای جستجوی لیست پزشکان را رندر می‌کند.
// ورودی: view و suffix یکتا برای id فیلدها (جلوگیری از تکرار در DOM).
templ doctorListFilterForm(view DoctorListView, suffix string) {
	<form class="mt-4 space-y-4 lg:mt-0" method="get" action={ templ.SafeURL(view.FormAction) }>
		<div>
			<label class="ui-label" for={ "q-" + suffix }>نام پزشک</label>
			<input
				id={ "q-" + suffix }
				name="q"
				type="search"
				value={ view.Query }
				placeholder="مثال: رضایی"
				autocomplete="off"
				class="ui-field"
			/>
		</div>
		<div>
			@components.DatePicker(components.DatePickerProps{
				ID:          "date-" + suffix,
				Name:        "date",
				Label:       "روز نوبت",
				Value:       view.Date,
				Help:        "فقط از امروز تا ۱۵ روز بعد. خالی = همه روزها.",
				Placeholder: "انتخاب تاریخ",
				HasDayRange: true,
				MinDays:     0,
				MaxDays:     15,
			})
		</div>
		<div class="space-y-2">
			@doctorListRadioFilter(doctorListSpecialtyRadioGroup(view, suffix))
			if desc := doctorListSpecialtyDescription(view); desc != "" {
				<div class="rounded-[10px] border border-brand/15 bg-brand-muted/70 px-2.5 py-2">
					<p class="text-xs font-bold text-brand-dark">{ doctorListSpecialtyName(view) }</p>
					<p class="mt-0.5 whitespace-pre-wrap text-xs leading-5 text-ink-muted">{ desc }</p>
				</div>
			}
		</div>
		if view.ShowClinicFilter {
			@doctorListRadioFilter(doctorListClinicRadioGroup(view, suffix))
		}
		<div class="flex flex-col gap-2 pt-1">
			<button type="submit" class="ui-btn ui-btn-primary ui-btn-block">اعمال فیلتر</button>
			<a class="ui-btn ui-btn-ghost ui-btn-block" href={ templ.SafeURL(view.FormAction) }>پاک کردن فیلترها</a>
		</div>
	</form>
}

// doctorListRadioFilter گروه تخصص یا مرکز را با حداکثر پنج گزینهٔ نمایان و disclosure بقیه رندر می‌کند.
// ورودی: group ساخته‌شده از دادهٔ view. خروجی: بلوک فیلتر رادیویی.
templ doctorListRadioFilter(group doctorListRadioGroup) {
	{{ visible, extra, expanded := doctorListRadioSplit(group.Items) }}
	<div class="rounded-xl border border-surface-border bg-white p-2.5 shadow-sm">
		<div class="mb-2 flex items-center justify-between gap-2 px-0.5">
			<p id={ group.GroupID + "-title" } class="text-sm font-bold text-ink">{ group.Title }</p>
			<p class="shrink-0 text-xs font-medium text-ink-faint">{ group.CountLabel }</p>
		</div>
		<div class="flex flex-col gap-1" role="radiogroup" aria-labelledby={ group.GroupID + "-title" }>
			@doctorListRadioOption(group.Name, group.GroupID+"-all", "", group.AllLabel, group.AllSelected)
			for i, item := range visible {
				@doctorListRadioOption(group.Name, group.GroupID+"-"+intToString(i), item.Value, item.Label, item.Selected)
			}
			if len(extra) > 0 {
				<details
					id={ group.MoreID }
					class="group/more flex flex-col"
					if expanded {
						open
					}
				>
					<summary class="order-last mt-1 flex min-h-[40px] w-full cursor-pointer list-none select-none items-center justify-center gap-1.5 border-t border-surface-border pt-2 text-sm font-semibold text-brand transition-colors hover:text-brand-dark focus-visible:ring-2 focus-visible:ring-brand/40 focus-visible:ring-offset-2 [&::-webkit-details-marker]:hidden">
						<span class="group-open/more:hidden">{ group.ShowMoreLabel }</span>
						<span class="hidden group-open/more:inline">{ group.HideMoreLabel }</span>
						<svg class="h-4 w-4 shrink-0 transition-transform duration-200 group-open/more:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
						</svg>
					</summary>
					<div class="order-first hidden flex-col gap-1 pt-1 group-open/more:flex">
						for i, item := range extra {
							@doctorListRadioOption(group.Name, group.GroupID+"-extra-"+intToString(i), item.Value, item.Label, item.Selected)
						}
					</div>
				</details>
			}
		</div>
	</div>
}

// doctorListRadioOption یک گزینهٔ رادیویی تمام‌عرض با حالت انتخاب، هاور و فوکوس کیبورد رندر می‌کند.
// ورودی: name فرم، id یکتا، value ارسالی، برچسب و وضعیت انتخاب.
templ doctorListRadioOption(name string, id string, value string, label string, selected bool) {
	<label for={ id } class="group/opt relative flex min-h-[42px] w-full cursor-pointer items-center gap-2.5 px-2.5 py-1.5">
		<input
			id={ id }
			class="peer sr-only"
			type="radio"
			name={ name }
			value={ value }
			if selected {
				checked
			}
		/>
		<span
			aria-hidden="true"
			class="pointer-events-none absolute inset-0 rounded-[11px] border border-surface-border bg-white transition-colors group-hover/opt:border-brand/30 group-hover/opt:bg-brand-muted/60 peer-checked:border-brand peer-checked:bg-brand-muted peer-focus-visible:ring-2 peer-focus-visible:ring-brand/35"
		></span>
		<span
			aria-hidden="true"
			class="relative z-[1] h-[18px] w-[18px] shrink-0 rounded-full border border-ink-faint bg-white transition-colors peer-checked:border-brand peer-checked:bg-brand peer-checked:shadow-[inset_0_0_0_4px_white]"
		></span>
		<span class="relative z-[1] min-w-0 flex-1 break-words text-sm leading-5 text-ink peer-checked:font-semibold peer-checked:text-brand-dark">{ label }</span>
	</label>
}
