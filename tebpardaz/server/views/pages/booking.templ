package pages

import "tebpardaz/server/views/components"

// Booking جزئیات پزشک و ویزارد چندمرحله‌ای رزرو را رندر می‌کند.
templ Booking(view BookingView) {
	<div
		class="bk-page"
		id="booking-root"
		data-ws-url={ view.WSURL }
		data-clinic-path={ view.ClinicPath }
		data-doctor-name={ view.DoctorName }
		data-otp-send-url="/otp/send"
		data-otp-verify-url="/otp/verify"
		data-patient-lookup-url="/patient/lookup"
	>
		<a class="bk-back" href={ templ.SafeURL(view.BackURL) }>
			بازگشت به فهرست پزشکان
		</a>
		<section class="bk-doctor-card">
			if view.PhotoURL != "" {
				<img class="bk-doctor-card__photo" src={ view.PhotoURL } alt="" width="80" height="80" loading="lazy"/>
			} else {
				<div class="bk-doctor-card__placeholder" aria-hidden="true">دکتر</div>
			}
			<div class="bk-doctor-card__info">
				if view.ShowClinic && view.ClinicName != "" {
					<span class="bk-doctor-card__clinic">{ view.ClinicName }</span>
				}
				<h1 class="bk-doctor-card__name">{ view.DoctorName }</h1>
				if view.SpecialtyName != "" {
					<p class="bk-doctor-card__spec">{ view.SpecialtyName }</p>
				}
			</div>
		</section>
		if view.ErrorMessage != "" {
			<p class="bk-alert" role="alert">{ view.ErrorMessage }</p>
		}
		@components.BookingStepper(components.BookingStepperView{ActiveStep: 1})
		<form
			id="booking-form"
			class="bk-wizard"
			method="post"
			action={ templ.SafeURL(view.SubmitURL) }
			autocomplete="off"
			novalidate
		>
			<input type="hidden" name="csrf_token" value={ view.CSRFToken }/>
			<input type="hidden" name="otp_ticket" id="otp_ticket" value=""/>
			<section class="bk-panel" id="booking-step-slots" data-step="1">
				<h2 class="bk-panel__title">نوبت را انتخاب کنید</h2>
				<p class="bk-panel__desc">روی یکی از کارت‌های زیر بزنید.</p>
				@components.BookingSlotGrid(components.BookingSlotCardView{
					InputName:  view.Slots.InputName,
					Options:    view.Slots.Options,
					EmptyText:  view.Slots.EmptyText,
					DoctorName: view.DoctorName,
				})
				<button type="button" id="booking-to-info" class="bk-btn bk-btn--primary bk-btn--block" disabled>
					ادامه
				</button>
			</section>
			<section class="bk-panel bk-hidden" id="booking-step-info" data-step="2" aria-hidden="true">
				<h2 class="bk-panel__title">اطلاعات بیمار</h2>
				@components.BookingPatientForm(components.BookingPatientFormView{})
			</section>
			@components.BookingOTPPanel(components.BookingOTPPanelView{CodeLength: 5})
			<div id="booking-progress" class="bk-hidden" aria-hidden="true">
				<ol class="bk-progress-steps">
					<li class="booking-step" data-step="1"><span class="booking-step-icon">1</span></li>
					<li class="booking-step" data-step="2"><span class="booking-step-icon">2</span></li>
					<li class="booking-step" data-step="3"><span class="booking-step-icon">3</span></li>
					<li class="booking-step" data-step="4"><span class="booking-step-icon">4</span></li>
				</ol>
			</div>
		</form>
		if len(view.Services) > 0 {
			<section class="bk-services-section">
				<h2 class="bk-services-section__title">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand">
						<path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
					</svg>
					خدمات و بیمه‌های تحت پوشش
				</h2>
				<div class="bk-services-grid">
					for _, srv := range view.Services {
						<div class="bk-service-card">
							<div class="bk-service-card__header">
								<h3 class="bk-service-card__name">{ srv.Name }</h3>
								if srv.Description != "" {
									<p class="bk-service-card__desc">{ srv.Description }</p>
								}
							</div>
							<div class="bk-service-card__insurances">
								<span class="bk-service-card__ins-label">بیمه‌های تحت پوشش:</span>
								if len(srv.Insurances) > 0 {
									<div class="bk-service-card__ins-list">
										for _, ins := range srv.Insurances {
											<div class="bk-service-ins-badge">
												if ins.LogoURL != "" {
													<img class="bk-service-ins-badge__logo" src={ ins.LogoURL } alt={ ins.Name } width="18" height="18" loading="lazy"/>
												}
												<span class="bk-service-ins-badge__name">{ ins.Name }</span>
											</div>
										}
									</div>
								} else {
									<span class="bk-service-card__ins-empty">فاقد پوشش بیمه‌ای اختصاصی (تعرفه آزاد)</span>
								}
							</div>
						</div>
					}
				</div>
			</section>
		}
		@components.BookingResultModal(components.BookingResultModalView{})
		@components.PersianDatepickerAssets()
		<link rel="stylesheet" href="/static/css/booking.css"/>
		<script src="/static/js/booking_validate.js" defer></script>
		<script src="/static/js/booking.js" defer></script>
		@components.ReviewSection(view.Reviews)
	</div>
}
