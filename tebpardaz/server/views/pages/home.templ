package pages

import "tebpardaz/server/views/components"

// Home محتوای لندینگ شامل هیرو، پزشکان، تخصص، مرکز و اخبار را رندر می‌کند.
templ Home(view HomeView) {
	<div class="ui-fade-in mx-auto max-w-6xl">
		<section class="ui-hero">
			<p class="ui-hero-brand">طب‌پرداز</p>
			<h1 class="ui-hero-title">رزرو نوبت، ساده و سریع</h1>
			<p class="ui-hero-text">
				پزشک را انتخاب کنید و نزدیک‌ترین زمان آزاد را رزرو کنید.
			</p>
			<div class="ui-hero-actions">
				<a class="ui-btn ui-btn-primary" href="/doctors">
					نوبت بگیرید
				</a>
			</div>
		</section>
		if len(view.Doctors) > 0 {
			<section class="ui-section">
				<div class="mb-4 flex items-end justify-between gap-3">
					<div class="ui-section-head mb-0 min-w-0">
						<h2 class="ui-section-title">پزشکان</h2>
						<p class="ui-section-desc">برای رزرو، روی کارت پزشک بزنید.</p>
					</div>
					<a class="ui-link shrink-0 text-sm" href="/doctors">مشاهده همه</a>
				</div>
				@components.DoctorCardAssets()
				<div class="grid items-stretch gap-4 sm:grid-cols-2 xl:grid-cols-3">
					for _, doc := range view.Doctors {
						@components.DoctorCard(doc)
					}
				</div>
			</section>
		}
		if len(view.Specialties) > 0 {
			<section class="ui-section">
				<div class="ui-section-head">
					<h2 class="ui-section-title">تخصص‌ها</h2>
					<p class="ui-section-desc">تخصص را انتخاب کنید تا پزشکان همان رشته را ببینید.</p>
				</div>
				@components.SpecialtyCardGrid(view.Specialties)
			</section>
		}
		if len(view.Insurances) > 0 {
			<section class="ui-section">
				<div class="ui-section-head">
					<h2 class="ui-section-title">بیمه‌های طرف قرارداد</h2>
					if view.ShowClinicCards {
						<p class="ui-section-desc">تجمیع بیمه‌های طرف قرارداد مراکز این مجموعه.</p>
					} else {
						<p class="ui-section-desc">بیمه‌هایی که این مرکز می‌پذیرد.</p>
					}
				</div>
				@components.InsuranceList(view.Insurances)
			</section>
		}
		if view.ShowClinicCards {
			if len(view.Clinics) > 0 {
				<section class="ui-section">
					<div class="ui-section-head">
						<h2 class="ui-section-title">مراکز درمانی</h2>
						<p class="ui-section-desc">کلینیک را انتخاب کنید تا پزشکان همان مرکز را ببینید.</p>
					</div>
					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
						for _, cl := range view.Clinics {
							@components.ClinicCard(cl)
						}
					</div>
				</section>
			}
		}
		<section class="ui-section">
			<div class="mb-4 flex items-end justify-between gap-3">
				<div class="ui-section-head mb-0 min-w-0">
					<h2 class="ui-section-title">آخرین اخبار</h2>
					<p class="ui-section-desc">اطلاعیه‌ها و توضیح تجهیزات مراکز.</p>
				</div>
				<a class="ui-link shrink-0 text-sm" href={ templ.SafeURL(view.NewsListURL) }>
					مشاهده همه
				</a>
			</div>
			if len(view.LatestNews) == 0 {
				<p class="py-6 text-center text-sm text-ink-muted">خبری برای نمایش وجود ندارد.</p>
			} else {
				<div class="news-grid">
					for _, item := range view.LatestNews {
						@components.NewsCard(homeNewsToCard(item))
					}
				</div>
			}
		</section>
	</div>
}
